<!-- ══ HERO ══ -->
<section class="hero">
    <div class="hero-inner">
        <div class="hero-text">
            <div class="hero-badge">
                <span></span>
                Masroor International Technical College
            </div>
            <h1>Build Real Skills.<br>Build a <em>Real Future.</em></h1>
            <p>
                MITC equips students with hands-on technical training guided by industry experts.
