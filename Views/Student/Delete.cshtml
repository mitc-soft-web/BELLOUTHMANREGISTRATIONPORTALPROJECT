@using Mitc_Registration_Portal.Models.DTOs
@model BaseResponse<Mitc_Registration_Portal.Models.DTOs.Students.StudentDtos>

@{
    ViewData["Title"] = "Delete Student";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    @@keyframes fadeInDown {
        from

    {
        opacity: 0;
        transform: translateY(-30px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    @@keyframes fadeInLeft {
        from

    {
        opacity: 0;
        transform: translateX(-30px);
    }

    to {
        opacity: 1;
        transform: translateX(0);
    }

    }

    @@keyframes fadeInRight {
        from

    {
        opacity: 0;
        transform: translateX(30px);
    }

    to {
        opacity: 1;
        transform: translateX(0);
    }

    }

    @@keyframes pulse {
        0%, 100%

    {
        transform: scale(1);
    }

    50% {
        transform: scale(1.05);
    }

    }

    @@keyframes shake {
        0%, 100%

    {
        transform: translateX(0);
    }

    10%, 30%, 50%, 70%, 90% {
        transform: translateX(-5px);
    }

    20%, 40%, 60%, 80% {
        transform: translateX(5px);
    }

    }

    :root {
        --brand-blue: #0066cc;
        --brand-dark: #004080;
        --danger: #dc3545;
        --warning: #ffc107;
        --light-bg: #f5f7fa;
    }

    body {
        background-color: var(--light-bg);
    }

    .delete-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem;
    }

    /* Header Banner */
    .header-banner {
        background: linear-gradient(135deg, var(--brand-blue) 0%, var(--brand-dark) 100%);
        color: white;
        padding: 3rem 2rem 5rem 2rem;
        margin: -2rem -2rem 2rem -2rem;
        border-radius: 0 0 2rem 2rem;
        position: relative;
        overflow: hidden;
        animation: fadeInDown 0.8s ease-out;
    }

        .header-banner::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -10%;
            width: 400px;
            height: 400px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 50%;
            animation: pulse 4s infinite;
        }

    .header-content {
        position: relative;
        z-index: 1;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .header-title h1 {
        font-size: 2.2rem;
        font-weight: 700;
        margin: 0 0 0.5rem 0;
    }

    .header-title p {
        margin: 0;
        opacity: 0.9;
        font-size: 1.05rem;
    }

    .back-btn {
        background: rgba(255, 255, 255, 0.2);
        border: 2px solid rgba(255, 255, 255, 0.3);
        color: white;
        padding: 0.75rem 2rem;
        border-radius: 2rem;
        text-decoration: none;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        backdrop-filter: blur(10px);
        transition: all 0.3s ease;
    }

        .back-btn:hover {
            background: white;
            color: var(--brand-blue);
            transform: translateX(-5px);
        }

    /* Content Grid */
    .content-grid {
        display: grid;
        grid-template-columns: 350px 1fr;
        gap: 2rem;
        margin-top: -3rem;
    }

    /* Profile Card */
    .profile-card {
        background: white;
        backdrop-filter: blur(10px);
        border-radius: 1.5rem;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.1);
        padding: 2.5rem;
        text-align: center;
        animation: fadeInLeft 0.8s ease-out 0.2s both;
        transition: all 0.3s ease;
    }

        .profile-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.15);
        }

    .profile-img-container {
        position: relative;
        display: inline-block;
        margin-bottom: 1.5rem;
    }

    .profile-img {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        object-fit: cover;
        border: 5px solid white;
        box-shadow: 0 8px 25px rgba(220, 53, 69, 0.3);
        transition: all 0.4s ease;
    }

    .profile-card:hover .profile-img {
        transform: scale(1.05);
        box-shadow: 0 12px 35px rgba(220, 53, 69, 0.4);
    }

    .status-badge {
        position: absolute;
        bottom: 10px;
        right: -10px;
        background: linear-gradient(135deg, var(--warning), #ff9800);
        color: #000;
        padding: 0.5rem 1rem;
        border-radius: 2rem;
        font-size: 0.75rem;
        font-weight: 700;
        box-shadow: 0 4px 15px rgba(255, 193, 7, 0.4);
        animation: shake 2s infinite;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .profile-name {
        font-size: 1.5rem;
        font-weight: 700;
        color: #1a1a1a;
        margin: 1rem 0 0.25rem 0;
    }

    .profile-matric {
        color: #6c757d;
        margin-bottom: 1.5rem;
    }

    .profile-divider {
        border: none;
        height: 2px;
        background: linear-gradient(to right, transparent, #e0e0e0, transparent);
        margin: 1.5rem 0;
    }

    .info-box {
        background: #f8f9fa;
        border-radius: 0.75rem;
        padding: 1rem;
        font-size: 0.9rem;
        color: #6c757d;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    /* Delete Confirmation Card */
    .delete-card {
        background: white;
        border-radius: 1.5rem;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.1);
        overflow: hidden;
        animation: fadeInRight 0.8s ease-out 0.2s both;
        transition: all 0.3s ease;
    }

        .delete-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.15);
        }

    .card-header-danger {
        background: white;
        padding: 1.5rem 2rem;
        border-bottom: 3px solid var(--danger);
        display: flex;
        align-items: center;
        gap: 1rem;
    }

        .card-header-danger h5 {
            margin: 0;
            font-size: 1.3rem;
            font-weight: 700;
            color: #1a1a1a;
        }

    .card-body-content {
        padding: 2rem;
    }

    /* Warning Alert */
    .warning-alert {
        background: linear-gradient(135deg, #fee2e2, #fecaca);
        border-left: 5px solid var(--danger);
        border-radius: 1rem;
        padding: 1.5rem;
        margin-bottom: 2rem;
        animation: pulse 2s infinite;
    }

    .alert-heading {
        color: #991b1b;
        font-weight: 700;
        margin-bottom: 0.75rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .alert-text {
        color: #7f1d1d;
        margin: 0;
        line-height: 1.6;
    }

    /* Info Grid */
    .info-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 2rem;
        margin-bottom: 2rem;
    }

    .info-item label {
        display: block;
        font-size: 0.8rem;
        font-weight: 700;
        color: #6c757d;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 0.5rem;
    }

    .info-item p {
        margin: 0;
        font-size: 1.05rem;
        font-weight: 600;
        color: #1a1a1a;
    }

    /* Action Buttons */
    .action-buttons {
        display: flex;
        gap: 1rem;
        padding-top: 2rem;
        border-top: 2px solid #f0f0f0;
        flex-wrap: wrap;
    }

    .btn-delete {
        background: linear-gradient(135deg, var(--danger), #a71d2a);
        color: white;
        border: none;
        padding: 1rem 3rem;
        border-radius: 0.75rem;
        font-weight: 700;
        font-size: 1.05rem;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.625rem;
        box-shadow: 0 4px 15px rgba(220, 53, 69, 0.3);
        cursor: pointer;
    }

        .btn-delete:hover {
            background: linear-gradient(135deg, #a71d2a, #7a1520);
            transform: translateY(-3px);
            box-shadow: 0 6px 25px rgba(220, 53, 69, 0.5);
        }

    .btn-cancel {
        background: white;
        border: 2px solid var(--brand-blue);
        color: var(--brand-blue);
        padding: 1rem 3rem;
        border-radius: 0.75rem;
        font-weight: 700;
        font-size: 1.05rem;
        text-decoration: none;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.625rem;
    }

        .btn-cancel:hover {
            background: var(--brand-blue);
            color: white;
            transform: translateY(-3px);
            box-shadow: 0 6px 25px rgba(0, 102, 204, 0.4);
        }

    /* Responsive */
    @@media (max-width: 992px) {
        .content-grid

    {
        grid-template-columns: 1fr;
    }

    .header-content {
        flex-direction: column;
        text-align: center;
    }

    .info-grid {
        grid-template-columns: 1fr;
        gap: 1.5rem;
    }

    .action-buttons {
        flex-direction: column;
    }

    .btn-delete,
    .btn-cancel {
        width: 100%;
        justify-content: center;
    }

    }
</style>

<div class="delete-container">
    <div class="header-banner">
        <div class="header-content">
            <div class="header-title">
                <h1> Delete Student Record</h1>
                <p>Review the information below before proceeding with deletion</p>
            </div>
            <a asp-action="Index" class="back-btn">
                <svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z" />
                </svg>
                Back to List
            </a>
        </div>
    </div>

    <div class="content-grid">
        <!-- Profile Card -->
        <div class="profile-card">
            <div class="profile-img-container">
                <img src="@(Model.Data.PassportUrl ?? "/images/default-avatar.png")" class="profile-img" alt="Student">
                <span class="status-badge">
                    <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z" />
                    </svg>
                    TO BE DELETED
                </span>
            </div>

            <h3 class="profile-name">@Model.Data.FirstName @Model.Data.LastName</h3>
            <p class="profile-matric">@Model.Data.MatricNumber</p>

            <hr class="profile-divider" />

            <div class="info-box">
                <svg width="18" height="18" fill="#0066cc" viewBox="0 0 16 16">
                    <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z" />
                    <path d="m8.93 6.588-2.29.287-.082.38.45.083c.294.07.352.176.288.469l-.738 3.468c-.194.897.105 1.319.808 1.319.545 0 1.178-.252 1.465-.598l.088-.416c-.2.176-.492.246-.686.246-.275 0-.375-.193-.304-.533L8.93 6.588zM9 4.5a1 1 0 1 1-2 0 1 1 0 0 1 2 0z" />
                </svg>
                <span>Student since @(Model.Data.ApprovedDate?.ToString("MMMM yyyy") ?? "N/A")</span>
            </div>
        </div>

        <!-- Delete Confirmation Card -->
        <div class="delete-card">
            <div class="card-header-danger">
                <svg width="28" height="28" fill="#dc3545" viewBox="0 0 16 16">
                    <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z" />
                    <path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3V2h11v1h-11z" />
                </svg>
                <h5>Confirmation Required</h5>
            </div>

            <div class="card-body-content">
                <div class="warning-alert">
                    <h6 class="alert-heading">
                        <svg width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z" />
                        </svg>
                        Warning: Permanent Action
                    </h6>
                    <p class="alert-text">
                        You are about to permanently remove <strong>@Model.Data.FirstName @Model.Data.LastName</strong> from the MITC Admin Portal.
                        This will delete all associated records, grades, and attendance logs. This action cannot be undone.
                    </p>
                </div>

                <div class="info-grid">
                    <div class="info-item">
                        <label>Email Address</label>
                        <p>@Model.Data.Email</p>
                    </div>
                    <div class="info-item">
                        <label>Registration Number</label>
                        <p>@Model.Data.RegistrationNumber</p>
                    </div>
                </div>

                <form asp-action="Delete" asp-route-id="@Model.Data.Id" asp-controller="Student" method="post">
                    @Html.AntiForgeryToken()
                    <div class="action-buttons">
                        <button type="submit" class="btn-delete">
                            <svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zM5.354 4.646a.5.5 0 1 0-.708.708L7.293 8l-2.647 2.646a.5.5 0 0 0 .708.708L8 8.707l2.646 2.647a.5.5 0 0 0 .708-.708L8.707 8l2.647-2.646a.5.5 0 0 0-.708-.708L8 7.293 5.354 4.646z" />
                            </svg>
                            Confirm Deletion
                        </button>

                        <a asp-action="GetStudentById" asp-route-id="@Model.Data.Id" class="btn-cancel">
                            <svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z" />
                                <path d="M10.97 4.97a.235.235 0 0 0-.02.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-1.071-1.05z" />
                            </svg>
                            Keep Record
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>