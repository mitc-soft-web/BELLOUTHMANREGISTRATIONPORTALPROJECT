@using Mitc_Registration_Portal.Models.DTOs
@using Mitc_Registration_Portal.Models.Enums
@model BaseResponse<Mitc_Registration_Portal.Models.DTOs.Students.StudentDtos>

<style>
    .admission-page {
        padding: 24px 0;
    }

    .admission-hero {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
        padding: 28px 30px;
        border-radius: 18px;
        background: linear-gradient(135deg, #005bbb 0%, #00386f 100%);
        color: #fff;
        box-shadow: 0 14px 28px rgba(0, 91, 187, 0.18);
        margin-bottom: 24px;
    }

    .admission-hero h1 {
        margin: 0 0 8px;
        font-size: 1.9rem;
        font-weight: 700;
    }

    .admission-hero p {
        margin: 0;
        max-width: 620px;
        line-height: 1.6;
        opacity: 0.92;
    }

    .hero-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 12px 18px;
        border-radius: 12px;
        text-decoration: none;
        color: #fff;
        font-weight: 700;
        border: 1px solid rgba(255,255,255,0.28);
        background: rgba(255,255,255,0.14);
    }

    .admission-grid {
        display: grid;
        grid-template-columns: 340px 1fr;
        gap: 24px;
        align-items: start;
    }

    .summary-card,
    .form-card {
        background: #fff;
        border-radius: 18px;
        box-shadow: 0 10px 24px rgba(15, 23, 42, 0.08);
        overflow: hidden;
    }

    .card-head {
        padding: 18px 22px;
        border-bottom: 1px solid #e9eff5;
        font-size: 1rem;
        font-weight: 700;
        color: #0f172a;
    }

    .card-body {
        padding: 22px;
    }

    .student-avatar {
        width: 120px;
        height: 120px;
        border-radius: 999px;
        object-fit: cover;
        display: block;
        margin: 0 auto 18px;
        border: 5px solid rgba(0, 91, 187, 0.12);
    }

    .student-name {
        text-align: center;
        margin: 0 0 4px;
        color: #0f172a;
        font-size: 1.35rem;
        font-weight: 700;
    }

    .student-subtitle {
        text-align: center;
        margin: 0 0 20px;
        color: #64748b;
    }

    .summary-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 12px;
    }

    .summary-list li {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        padding: 13px 14px;
        border: 1px solid #e8edf3;
        border-radius: 12px;
        background: #f8fafc;
    }

    .summary-list strong {
        color: #64748b;
        font-size: 0.84rem;
    }

    .summary-list span {
        text-align: right;
        font-weight: 700;
        color: #0f172a;
    }

    .status-tip {
        margin-top: 18px;
        padding: 14px 16px;
        border-radius: 12px;
        background: #eef6ff;
        border: 1px solid #cfe1f9;
        color: #1e4f8a;
        line-height: 1.6;
        font-size: 0.92rem;
    }

    .form-stack {
        display: grid;
        gap: 18px;
    }

    .field-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .field-group label {
        color: #334155;
        font-size: 0.9rem;
        font-weight: 700;
    }

    .helper-text {
        color: #64748b;
        font-size: 0.88rem;
        line-height: 1.5;
    }

    .form-control {
        width: 100%;
        padding: 12px 14px;
        border-radius: 12px;
        border: 1px solid #d7e0ea;
        background: #fff;
        color: #0f172a;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

    .form-control:focus {
        outline: none;
        border-color: #2563eb;
        box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.12);
    }

    .text-danger {
        color: #dc2626;
        font-size: 0.84rem;
    }

    .alert {
        padding: 14px 16px;
        border-radius: 12px;
        margin-bottom: 16px;
        font-weight: 600;
    }

    .alert-danger {
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #b91c1c;
    }

    .alert-success {
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
        color: #166534;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 10px;
    }

    .btn-linkish,
    .btn-primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 12px 18px;
        border-radius: 12px;
        text-decoration: none;
        font-weight: 700;
        border: none;
        cursor: pointer;
    }

    .btn-linkish {
        background: #f1f5f9;
        color: #334155;
        border: 1px solid #d7e0ea;
    }

    .btn-primary {
        background: linear-gradient(135deg, #005bbb 0%, #00386f 100%);
        color: #fff;
    }

    @@media (max-width: 960px) {
        .admission-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 768px) {
        .admission-hero {
            flex-direction: column;
            align-items: flex-start;
        }

        .form-actions {
            flex-direction: column;
        }

        .btn-linkish,
        .btn-primary {
            width: 100%;
        }
    }

    /* Modal Styles */
    .modal-content {
        border-radius: 18px;
        border: none;
        overflow: hidden;
    }
    .modal-header {
        background: #f8fafc;
        border-bottom: 1px solid #e9eff5;
        padding: 18px 24px;
    }
    .modal-title {
        font-weight: 700;
        color: #0f172a;
    }
    .modal-body {
        padding: 24px;
    }
    .waec-section {
        margin-top: 20px;
    }
    .waec-section h4 {
        margin-bottom: 12px;
        color: #0f172a;
        font-size: 1.1rem;
        font-weight: 700;
        border-bottom: 2px solid #e9eff5;
        padding-bottom: 8px;
    }
    .waec-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 10px;
    }
    .waec-table th, .waec-table td {
        padding: 12px 14px;
        border-bottom: 1px solid #e9eff5;
        text-align: left;
    }
    .waec-table th {
        background: #f8fafc;
        font-weight: 600;
        color: #64748b;
        font-size: 0.85rem;
        text-transform: uppercase;
    }
    .waec-table tr:last-child td {
        border-bottom: none;
    }
    .exam-details {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
        margin-bottom: 20px;
        background: #f8fafc;
        padding: 16px;
        border-radius: 12px;
        border: 1px solid #e9eff5;
    }
    .exam-details div strong {
        display: block;
        color: #64748b;
        font-size: 0.85rem;
        margin-bottom: 4px;
    }
    .exam-details div span {
        color: #0f172a;
        font-weight: 600;
    }
</style>

<div class="admission-page">
    <div class="admission-hero">
        <div>
            <h1>Update Admission Status</h1>
            <p>Set the student's admission status and assign the department or course the student should receive with the admission offer.</p>
        </div>
        <a asp-action="GetStudentById" asp-route-id="@(Model?.Data?.Id)" class="hero-link">Back to Profile</a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <div class="admission-grid">
        <div class="summary-card">
            <div class="card-head">Student Summary</div>
            <div class="card-body">
                <img class="student-avatar"
                     src="@(string.IsNullOrWhiteSpace(Model?.Data?.PassportUrl) ? "/images/default-avatar.png" : Model.Data.PassportUrl)"
                     alt="Student passport" />

                <h2 class="student-name">@Model?.Data?.FirstName @Model?.Data?.LastName</h2>
                <p class="student-subtitle">@Model?.Data?.Email</p>

                <ul class="summary-list">
                    <li>
                        <strong>Current Status</strong>
                        <span>@Model?.Data?.Status</span>
                    </li>
                    <li>
                        <strong>Registration No.</strong>
                        <span>@Model?.Data?.RegistrationNumber</span>
                    </li>
                    <li>
                        <strong>Current Department</strong>
                        <span>@(Model?.Data?.DepartmentName ?? "Not assigned")</span>
                    </li>
                </ul>

                <div class="status-tip">
                    When you admit the student, the email notification will include the department selected on this page.
                </div>
            </div>
        </div>

        <div class="form-card">
            <div class="card-head">Admission Decision</div>
            <div class="card-body">
                <form asp-action="Edit" asp-route-id="@(Model?.Data?.Id)" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    @if (Model?.Data != null && (Model.Data.Status == Status.Admitted || Model.Data.Status == Status.Rejected))
                    {
                        <div class="alert alert-warning" style="background:#fffbeb; border:1px solid #fef3c7; color:#b45309; margin-bottom: 20px; font-size: 0.95rem;">
                            <strong>Admission Decision Final:</strong> This applicant's status is set as <strong>@Model.Data.Status</strong>. The admission decision is permanent and cannot be modified.
                        </div>
                        <input type="hidden" name="Status" value="@((byte)Model.Data.Status)" />
                    }

                    <div class="form-stack">
                        <div class="field-group">
                            <label for="DepartmentId">Assigned Department / Course</label>
                            <select id="DepartmentId" name="DepartmentId" class="form-select" asp-items="Model.Data.DepartmentsSelectListItems" 
                                    disabled="@(Model.Data.Status == Status.Admitted || Model.Data.Status == Status.Rejected ? "disabled" : null)"></select>
                            <div class="helper-text">Admin can change this before saving, especially when issuing admission.</div>
                            @if (Model.Data.Status == Status.Admitted || Model.Data.Status == Status.Rejected)
                            {
                                <input type="hidden" name="DepartmentId" value="@Model.Data.DepartmentId" />
                            }
                        </div>

                        <div class="field-group">
                            <label for="Status">Admission Status</label>
                            <select id="Status" name="Status" class="form-select" 
                                    disabled="@(Model.Data.Status == Status.Admitted || Model.Data.Status == Status.Rejected ? "disabled" : null)">
                                @{
                                    var current = Model?.Data != null ? Convert.ToByte(Model.Data.Status).ToString() : "";
                                    var pendingValue = Convert.ToByte(Status.Pending).ToString();
                                    foreach (var item in Html.GetEnumSelectList<Status>())
                                    {
                                        if (item.Value == pendingValue)
                                        {
                                            continue; // Exclude Pending option
                                        }
                                        if (item.Value == current)
                                        {
                                            <option value="@item.Value" selected>@item.Text</option>
                                        }
                                        else
                                        {
                                            <option value="@item.Value">@item.Text</option>
                                        }
                                    }
                                }
                            </select>
                            <div class="helper-text">Choose whether the student should be admitted or rejected.</div>
                        </div>
                    </div>

                    <div class="form-actions">
                        <button type="button" class="btn-linkish" data-bs-toggle="modal" data-bs-target="#detailsModal">View Full Details</button>
                        <a asp-action="GetStudentById" asp-route-id="@(Model?.Data?.Id)" class="btn-linkish">Cancel</a>
                        <button type="submit" class="btn-primary" 
                                disabled="@(Model?.Data?.Status == Status.Admitted || Model?.Data?.Status == Status.Rejected ? "disabled" : null)">
                            Save Admission Update
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Details Modal -->
<div class="modal fade" id="detailsModal" tabindex="-1" aria-labelledby="detailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="detailsModalLabel">Student Full Details & WAEC Results</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row mb-4">
                    <div class="col-md-4 text-center">
                        <img src="@(string.IsNullOrWhiteSpace(Model?.Data?.PassportUrl) ? "/images/default-avatar.png" : Model.Data.PassportUrl)" 
                             alt="Student Passport" class="img-fluid rounded shadow-sm" style="max-height: 180px; object-fit: cover;" />
                    </div>
                    <div class="col-md-8">
                        <div class="row">
                            <div class="col-sm-6 mb-3">
                                <small class="text-muted d-block fw-bold">Full Name</small>
                                <span class="fw-semibold">@Model?.Data?.FirstName @Model?.Data?.MiddleName @Model?.Data?.LastName</span>
                            </div>
                            <div class="col-sm-6 mb-3">
                                <small class="text-muted d-block fw-bold">Email</small>
                                <span class="fw-semibold">@Model?.Data?.Email</span>
                            </div>
                            <div class="col-sm-6 mb-3">
                                <small class="text-muted d-block fw-bold">Phone Number</small>
                                <span class="fw-semibold">@Model?.Data?.PhoneNumber</span>
                            </div>
                            <div class="col-sm-6 mb-3">
                                <small class="text-muted d-block fw-bold">NIN</small>
                                <span class="fw-semibold">@Model?.Data?.NIN</span>
                            </div>
                            <div class="col-sm-6 mb-3">
                                <small class="text-muted d-block fw-bold">Gender</small>
                                <span class="fw-semibold">@Model?.Data?.Gender</span>
                            </div>
                            <div class="col-sm-6 mb-3">
                                <small class="text-muted d-block fw-bold">Date of Birth</small>
                                <span class="fw-semibold">@(Model?.Data?.DateOfBirth?.ToString("MMM dd, yyyy"))</span>
                            </div>
                        </div>
                    </div>
                </div>

                @if (Model?.Data?.WaecDetails != null)
                {
                    <div class="waec-section">
                        <h4>Examination Results</h4>
                        <div class="exam-details">
                            <div>
                                <strong>Sitting Type</strong>
                                <span>@Model.Data.WaecDetails.SittingType</span>
                            </div>
                            <div>
                                <strong>First Sitting</strong>
                                <span>@(Model.Data.WaecDetails.ExaminationBody ?? "WAEC") - @Model.Data.WaecDetails.ExaminationNumber (@Model.Data.WaecDetails.ExaminationYear)</span>
                            </div>
                            @if (Model.Data.WaecDetails.SittingType == ResultSittingType.TwoSittings)
                            {
                                <div>
                                    <strong>Second Sitting</strong>
                                    <span>@(Model.Data.WaecDetails.SecondExaminationBody ?? "WAEC") - @Model.Data.WaecDetails.SecondExaminationNumber (@Model.Data.WaecDetails.SecondExaminationYear)</span>
                                </div>
                            }
                        </div>

                        <div class="table-responsive">
                            <table class="waec-table">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Subject</th>
                                        <th>Grade</th>
                                        <th>Sitting / Body</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.Data.WaecDetails.SubjectResults != null && Model.Data.WaecDetails.SubjectResults.Any())
                                    {
                                        var count = 1;
                                        foreach (var result in Model.Data.WaecDetails.SubjectResults)
                                        {
                                            <tr>
                                                <td>@(count++)</td>
                                                <td class="fw-semibold text-dark">@result.Subject</td>
                                                <td><span class="badge bg-primary rounded-pill">@result.Grade</span></td>
                                                <td>
                                                    Sitting @result.SittingNumber 
                                                    <span class="text-muted d-block" style="font-size:0.8rem;">
                                                        (@(result.SittingNumber == 2 ? (Model.Data.WaecDetails.SecondExaminationBody ?? "WAEC") : (Model.Data.WaecDetails.ExaminationBody ?? "WAEC")))
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="4" class="text-center text-muted">No result details found.</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning mt-4">
                        WAEC Results are not available for this student.
                    </div>
                }
            </div>
        </div>
    </div>
</div>
