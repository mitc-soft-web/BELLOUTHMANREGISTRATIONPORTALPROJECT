@using Mitc_Registration_Portal.Models.DTOs
@model BaseResponse<Mitc_Registration_Portal.Models.DTOs.Students.StudentDtos>

@{
    ViewData["Title"] = "Student Profile";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

 <style>
    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes slideInLeft {
        from {
            opacity: 0;
            transform: translateX(-30px);
        }
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    @@keyframes slideInRight {
        from {
            opacity: 0;
            transform: translateX(30px);
        }
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    @@keyframes scaleIn {
        from {
            opacity: 0;
            transform: scale(0.9);
        }
        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    @@keyframes pulse {
        0%, 100% {
            transform: scale(1);
        }
        50% {
            transform: scale(1.05);
        }
    }

    @@keyframes shimmer {
        0% {
            background-position: -1000px 0;
        }
        100% {
            background-position: 1000px 0;
        }
    }

    @@keyframes float {
        0%, 100% {
            transform: translateY(0);
        }
        50% {
            transform: translateY(-10px);
        }
    }

    :root {
        --primary: #0066cc;
        --primary-dark: #004080;
        --success: #28a745;
        --warning: #ffc107;
        --danger: #dc3545;
        --light-bg: #f5f7fa;
    }

    body {
        background: var(--light-bg);
    }

    .profile-container {
        animation: fadeInUp 0.6s ease-out;
    }

    /* Header Banner */
    .profile-header {
        background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
        color: white;
        padding: 2.5rem;
        border-radius: 1rem 1rem 0 0;
        position: relative;
        overflow: hidden;
        animation: slideInRight 0.8s ease-out;
    }

    .profile-header::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -10%;
        width: 400px;
        height: 400px;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 50%;
        animation: pulse 4s infinite;
    }

    .profile-header-content {
        position: relative;
        z-index: 1;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    /* Profile Card */
    .profile-card {
        background: white;
        border-radius: 1rem;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        overflow: hidden;
        animation: slideInLeft 0.8s ease-out;
        transition: all 0.3s ease;
    }

    .profile-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 30px rgba(0, 102, 204, 0.15);
    }

    .profile-card-body {
        padding: 2.5rem;
        text-align: center;
    }

    /* Avatar */
    .avatar-container {
        position: relative;
        display: inline-block;
        margin-bottom: 1.5rem;
        animation: scaleIn 1s ease-out 0.3s both;
    }

    .avatar-img {
        width: 180px;
        height: 180px;
        border-radius: 50%;
        object-fit: cover;
        border: 5px solid white;
        box-shadow: 0 8px 25px rgba(0, 102, 204, 0.3);
        transition: all 0.4s ease;
    }

    .profile-card:hover .avatar-img {
        transform: scale(1.05) rotate(5deg);
        box-shadow: 0 12px 35px rgba(0, 102, 204, 0.4);
    }

    .status-badge {
        position: absolute;
        bottom: 10px;
        right: 10px;
        padding: 0.5rem 1rem;
        border-radius: 2rem;
        font-weight: 700;
        font-size: 0.85rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        animation: pulse 2s infinite;
    }

    .status-admitted {
        background: linear-gradient(135deg, #28a745, #1e7e34);
        color: white;
        box-shadow: 0 4px 15px rgba(40, 167, 69, 0.4);
    }

    .status-pending {
        background: linear-gradient(135deg, #ffc107, #ff9800);
        color: white;
        box-shadow: 0 4px 15px rgba(255, 193, 7, 0.4);
    }

    /* Info Card */
    .info-card {
        background: white;
        border-radius: 1rem;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        overflow: hidden;
        animation: slideInRight 0.8s ease-out;
        transition: all 0.3s ease;
    }

    .info-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 30px rgba(0, 102, 204, 0.15);
    }

    .card-header-custom {
        background: linear-gradient(to right, #f8f9fa, #e9ecef);
        padding: 1.5rem;
        border-bottom: 3px solid var(--primary);
    }

    .card-title {
        margin: 0;
        font-size: 1.4rem;
        font-weight: 700;
        color: var(--primary);
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .info-grid {
        padding: 2rem;
    }

    .info-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 2rem;
        margin-bottom: 1.5rem;
    }

    .info-item {
        animation: fadeInUp 0.6s ease-out both;
        transition: all 0.3s ease;
    }

    .info-item:nth-child(1) { animation-delay: 0.1s; }
    .info-item:nth-child(2) { animation-delay: 0.2s; }
    .info-item:nth-child(3) { animation-delay: 0.3s; }
    .info-item:nth-child(4) { animation-delay: 0.4s; }
    .info-item:nth-child(5) { animation-delay: 0.5s; }
    .info-item:nth-child(6) { animation-delay: 0.6s; }

    .info-item:hover {
        transform: translateX(5px);
    }

    .info-label {
        font-size: 0.85rem;
        font-weight: 600;
        color: #6c757d;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 0.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .info-value {
        font-size: 1.1rem;
        font-weight: 600;
        color: #1a1a1a;
        padding: 0.75rem 0;
        border-bottom: 2px solid #f0f0f0;
        transition: all 0.3s ease;
    }

    .info-item:hover .info-value {
        border-bottom-color: var(--primary);
        color: var(--primary);
    }

    /* Action Buttons */
    .action-btn {
        width: 100%;
        padding: 0.875rem;
        border: none;
        border-radius: 0.625rem;
        font-weight: 600;
        font-size: 0.95rem;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.625rem;
        text-decoration: none;
        margin-bottom: 0.75rem;
    }

    .btn-primary-custom {
        background: linear-gradient(135deg, var(--primary), var(--primary-dark));
        color: white;
        box-shadow: 0 4px 15px rgba(0, 102, 204, 0.3);
    }

    .btn-primary-custom:hover {
        transform: translateY(-3px);
        box-shadow: 0 6px 25px rgba(0, 102, 204, 0.4);
        color: white;
    }

    .btn-outline-custom {
        background: white;
        border: 2px solid var(--primary);
        color: var(--primary);
    }

    .btn-outline-custom:hover {
        background: var(--primary);
        color: white;
        transform: translateY(-3px);
        box-shadow: 0 6px 25px rgba(0, 102, 204, 0.4);
    }

    .btn-dark-custom {
        background: #1a1a1a;
        color: white;
    }

    .btn-dark-custom:hover {
        background: #000;
        transform: translateY(-3px);
        box-shadow: 0 6px 25px rgba(0, 0, 0, 0.3);
        color: white;
    }

    /* Details Card */
    .details-card {
        background: white;
        border-radius: 1rem;
        padding: 1.5rem;
        margin-top: 1.5rem;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        animation: fadeInUp 0.8s ease-out 0.4s both;
        border-left: 5px solid var(--primary);
    }

    .details-title {
        font-size: 0.9rem;
        font-weight: 700;
        color: #6c757d;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 1rem;
    }

    .details-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .details-item {
        display: flex;
        justify-content: space-between;
        padding: 0.875rem 0;
        border-bottom: 1px solid #f0f0f0;
        transition: all 0.3s ease;
    }

    .details-item:hover {
        background: #f8f9fa;
        padding-left: 0.5rem;
    }

    .details-item:last-child {
        border-bottom: none;
    }

    /* Alert */
    .rejection-alert {
        background: linear-gradient(135deg, #fee2e2, #fecaca);
        border-left: 5px solid var(--danger);
        border-radius: 1rem;
        padding: 1.5rem;
        animation: fadeInUp 0.8s ease-out, pulse 2s infinite;
        box-shadow: 0 4px 20px rgba(220, 38, 38, 0.2);
    }

    .alert-heading {
        color: #991b1b;
        font-weight: 700;
        margin-bottom: 0.75rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .alert-text {
        color: #7f1d1d;
        margin: 0;
        line-height: 1.6;
    }

    /* Back Button */
    .back-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.625rem 1.25rem;
        background: rgba(255, 255, 255, 0.2);
        color: white;
        border: 2px solid rgba(255, 255, 255, 0.3);
        border-radius: 0.5rem;
        text-decoration: none;
        font-weight: 600;
        transition: all 0.3s ease;
        backdrop-filter: blur(10px);
    }

    .back-btn:hover {
        background: white;
        color: var(--primary);
        transform: translateX(-5px);
    }

    /* Responsive */
    @@media (max-width: 992px) {
        .profile-header-content {
            flex-direction: column;
            gap: 1rem;
            text-align: center;
        }

        .info-row {
            grid-template-columns: 1fr;
        }

        .avatar-img {
            width: 150px;
            height: 150px;
        }
    }
</style> 

<div class="profile-container">
    <div class="profile-header">
        <div class="profile-header-content">
            <div>
                <h1 style="font-size: 2rem; font-weight: 700; margin-bottom: 0.5rem;">Student Profile</h1>
                <p style="opacity: 0.95; margin: 0;">Complete student information and records</p>
            </div>
            <a asp-action="GetAllStudent" class="back-btn">
                <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
                Back to List
            </a>
        </div>
    </div>

    <div style="padding: 2rem;">
        <div style="display: grid; grid-template-columns: 350px 1fr; gap: 2rem;">
            <!-- Left Sidebar -->
            <div>
                <div class="profile-card">
                    <div class="profile-card-body">
                        <div class="avatar-container">
                            <img src="@(string.IsNullOrEmpty(Model.Data.PassportUrl) ? "/images/default-avatar.png" : Model.Data.PassportUrl)"
                                 alt="Student Passport"
                                 class="avatar-img" />
                            <span class="status-badge @(Model.Data.Status == Mitc_Registration_Portal.Models.Enums.Status.Admitted ? "status-admitted" : "status-pending")">
                                <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                    @if (Model.Data.Status == Mitc_Registration_Portal.Models.Enums.Status.Admitted)
                                    {
                                        <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
                                    }
                                    else
                                    {
                                        <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                                        <path d="M8 4a.5.5 0 0 1 .5.5v3a.5.5 0 0 1-1 0v-3A.5.5 0 0 1 8 4zM8 10a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
                                    }
                                </svg>
                                @Model.Data.Status
                            </span>
                        </div>

                        <h4 style="font-size: 1.5rem; font-weight: 700; color: #1a1a1a; margin-bottom: 0.25rem;">
                            @Model.Data.FirstName @Model.Data.LastName
                        </h4>
                        <p style="color: #6c757d; margin-bottom: 1.5rem;">@Model.Data.MatricNumber</p>

                        <hr style="margin: 1.5rem 0; border-color: #f0f0f0;" />

                        <a href="mailto:@Model.Data.Email" class="action-btn btn-outline-custom">
                            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                            </svg>
                            Email Student
                        </a>

                        <a asp-action="Edit" asp-route-id="@Model.Data.Id" class="action-btn btn-primary-custom">
                            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                            </svg>
                            Update Admission Status
                        </a>

                        <a asp-action="Delete" asp-route-id="@Model.Data.Id" class="action-btn btn-dark-custom" onclick="return confirm('Are you sure you want to delete this student?');">
                            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                            </svg>
                            Delete Student
                        </a>
                    </div>
                </div>

                <div class="details-card">
                    <h6 class="details-title">Registration Details</h6>
                    <ul class="details-list">
                        <li class="details-item">
                            <strong style="color: #6c757d;">Reg Number</strong>
                            <span style="color: var(--primary); font-weight: 600;">@Model.Data.RegistrationNumber</span>
                        </li>
                        <li class="details-item">
                            <strong style="color: #6c757d;">Department</strong>
                            <span style="color: #1a1a1a; font-weight: 600;">@(Model.Data.DepartmentName ?? "Not assigned")</span>
                        </li>
                        <li class="details-item">
                            <strong style="color: #6c757d;">Date Joined</strong>
                            <span style="color: #1a1a1a; font-weight: 600;">@(Model.Data.DateCreated.ToString("MMM dd, yyyy") ?? "N/A")</span>
                        </li>
                        @* <li class="details-item">
                            <strong style="color: #6c757d;">Student ID</strong>
                            <span style="color: #1a1a1a; font-weight: 600;">@Model.Data.Id</span>
                        </li> *@
                    </ul>
                </div>
            </div>

            <!-- Main Content -->
            <div>
                <div class="info-card">
                    <div class="card-header-custom">
                        <h5 class="card-title">
                            <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                            </svg>
                            Personal Information
                        </h5>
                    </div>

                    <div class="info-grid">
                        <div class="info-row">
                            <div class="info-item">
                                <div class="info-label">
                                    <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0zm4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4zm-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10c-2.29 0-3.516.68-4.168 1.332-.678.678-.83 1.418-.832 1.664h10z"/>
                                    </svg>
                                    Full Name
                                </div>
                                <div class="info-value">@Model.Data.FirstName @Model.Data.MiddleName @Model.Data.LastName</div>
                            </div>

                            <div class="info-item">
                                <div class="info-label">
                                    <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M.05 3.555A2 2 0 0 1 2 2h12a2 2 0 0 1 1.95 1.555L8 8.414.05 3.555zM0 4.697v7.104l5.803-3.558L0 4.697zM6.761 8.83l-6.57 4.027A2 2 0 0 0 2 14h12a2 2 0 0 0 1.808-1.144l-6.57-4.027L8 9.586l-1.239-.757zm3.436-.586L16 11.801V4.697l-5.803 3.546z"/>
                                    </svg>
                                    Email Address
                                </div>
                                <div class="info-value">@Model.Data.Email</div>
                            </div>
                        </div>

                        <div class="info-row">
                            <div class="info-item">
                                <div class="info-label">
                                    <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M1.885.511a1.745 1.745 0 0 1 2.61.163L6.29 2.98c.329.423.445.974.315 1.494l-.547 2.19a.678.678 0 0 0 .178.643l2.457 2.457a.678.678 0 0 0 .644.178l2.189-.547a1.745 1.745 0 0 1 1.494.315l2.306 1.794c.829.645.905 1.87.163 2.611l-1.034 1.034c-.74.74-1.846 1.065-2.877.702a18.634 18.634 0 0 1-7.01-4.42 18.634 18.634 0 0 1-4.42-7.009c-.362-1.03-.037-2.137.703-2.877L1.885.511z"/>
                                    </svg>
                                    Phone Number
                                </div>
                                <div class="info-value">@Model.Data.PhoneNumber</div>
                            </div>

                            <div class="info-item">
                                <div class="info-label">
                                    <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2zm3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/>
                                    </svg>
                                    Gender
                                </div>
                                <div class="info-value">@Model.Data.Gender</div>
                            </div>
                        </div>

                        <div class="info-row">
                            <div class="info-item">
                                <div class="info-label">
                                    <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M4 .5a.5.5 0 0 0-1 0V1H2a2 2 0 0 0-2 2v1h16V3a2 2 0 0 0-2-2h-1V.5a.5.5 0 0 0-1 0V1H4V.5zM16 14V5H0v9a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2zM8 7.5a.5.5 0 0 1 .5.5v3h1.5a.5.5 0 0 1 0 1h-2a.5.5 0 0 1-.5-.5v-3.5a.5.5 0 0 1 .5-.5z"/>
                                    </svg>
                                    Date of Birth
                                </div>
                                <div class="info-value">@(Model.Data.DateOfBirth?.ToString("dd MMMM, yyyy") ?? "N/A")</div>
                            </div>

                            <div class="info-item">
                                <div class="info-label">
                                    <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10zm0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6z"/>
                                    </svg>
                                    Location
                                </div>
                                <div class="info-value">@Model.Data.City, @Model.Data.State</div>
                            </div>
                        </div>

                        <div class="info-row">
                            <div class="info-item" style="grid-column: 1 / -1;">
                                <div class="info-label">
                                    <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M8.707 1.5a1 1 0 0 0-1.414 0L.646 8.146a.5.5 0 0 0 .708.708L2 8.207V13.5A1.5 1.5 0 0 0 3.5 15h9a1.5 1.5 0 0 0 1.5-1.5V8.207l.646.647a.5.5 0 0 0 .708-.708L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293L8.707 1.5zM13 7.207V13.5a.5.5 0 0 1-.5.5h-9a.5.5 0 0 1-.5-.5V7.207l5-5 5 5z"/>
                                    </svg>
                                    Residential Address
                                </div>
                                <div class="info-value">@Model.Data.Address</div>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.Data.RejectionReason))
                        {
                            <div class="info-row" style="margin-top: 2rem;">
                                <div style="grid-column: 1 / -1;">
                                    <div class="rejection-alert">
                                        <h6 class="alert-heading">
                                            <svg width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                                                <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.8890 1.767-.98 1.767l-6.837-11.667zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z" />
                                            </svg>
                                            Rejection Notice
                                        </h6>
                                        <p class="alert-text">@Model.Data.RejectionReason</p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                @*
            <div class="info-card" style="margin-top: 2rem;">
                <div class="card-header-custom">
                    <h5 class="card-title">
                        <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
