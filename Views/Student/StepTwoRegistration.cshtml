@using Mitc_Registration_Portal.Models.Enums
@using Mitc_Registration_Portal.Models.DTOs.Waecs
@model Mitc_Registration_Portal.Models.DTOs.Document.DocumentViewModel
@{
    ViewData["Title"] = "Student Registration - Step 2";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var gradeOptions = new[] { "A1", "B2", "B3", "C4", "C5", "C6", "D7", "E8", "F9" };
    var waecSubjects = new[]
    {
        "Agricultural Science", "Biology", "Chemistry", "Civic Education", "Commerce",
        "Computer Studies", "CRK/IRK", "Data Processing", "Economics", "Financial Accounting",
        "Food and Nutrition", "French", "Further Mathematics", "Geography", "Government",
        "Hausa", "Igbo", "Literature in English", "Marketing", "Physical Education",
        "Physics", "Technical Drawing", "Yoruba"
    }.ToList();
    waecSubjects.Insert(0, "Mathematics");
    waecSubjects.Insert(0, "English Language");
}

<style>
    * {
        box-sizing: border-box;
    }

    .registration-shell {
        min-height: 85vh;
        padding: 48px 18px;
        background: linear-gradient(135deg, #f5f7fa 0%, #dbe7f5 100%);
    }

    .registration-card {
        max-width: 1020px;
        margin: 0 auto;
        background: #fff;
        border-radius: 20px;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.12);
        overflow: hidden;
    }

    .registration-header {
        padding: 42px 38px 32px;
        color: #fff;
        background: linear-gradient(135deg, #005bbb 0%, #003b78 100%);
    }

    .registration-header h1 {
        margin: 0 0 10px;
        font-size: 2rem;
        font-weight: 700;
    }

    .registration-header p {
        margin: 0;
        max-width: 680px;
        line-height: 1.6;
        opacity: 0.92;
    }

    /* ─── Progress Steps (3-step) ────────────────────── */
    .progress-steps {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        padding: 32px 40px 28px;
        background: #f8f9fa;
        border-bottom: 1px solid #e8eaed;
        gap: 0;
    }

    .step {
        display: flex;
        flex-direction: column;
        align-items: center;
        position: relative;
        flex: 1;
        max-width: 180px;
    }

    .step-connector {
        flex: 1;
        height: 3px;
        background: #e0e0e0;
        margin-top: 21px;
        border-radius: 2px;
        max-width: 100px;
        transition: background 0.4s;
    }

    .step-connector.done {
        background: #28a745;
    }

    .step-number {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: #e8eaed;
        color: #aaa;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 1em;
        margin-bottom: 10px;
        transition: all 0.3s;
        position: relative;
        z-index: 2;
    }

    .step.active .step-number {
        background: #0066cc;
        color: #fff;
        box-shadow: 0 0 0 5px rgba(0, 102, 204, 0.18);
    }

    .step.completed .step-number {
        background: #28a745;
        color: #fff;
    }

    .step-label {
        font-size: 0.82em;
        color: #999;
        font-weight: 500;
        text-align: center;
        line-height: 1.3;
    }

    .step.active .step-label {
        color: #0066cc;
        font-weight: 700;
    }

    .step.completed .step-label {
        color: #28a745;
        font-weight: 600;
    }

    .form-body {
        padding: 36px 38px 40px;
    }

    .info-banner,
    .tips-banner {
        border-radius: 14px;
        padding: 16px 18px;
        margin-bottom: 24px;
        line-height: 1.6;
        font-size: 0.95rem;
    }

    .info-banner {
        background: #eef6ff;
        border: 1px solid #c9def8;
        color: #1d4e89;
    }

    .tips-banner {
        background: #fff9e7;
        border: 1px solid #f5d76e;
        color: #755700;
    }

    .section-title {
        margin: 0 0 18px;
        padding-bottom: 12px;
        border-bottom: 2px solid #eff4fa;
        font-size: 1.08rem;
        font-weight: 700;
        color: #0f172a;
    }

    .field-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 18px;
        margin-bottom: 22px;
    }

    .field-group {
        display: flex;
        flex-direction: column;
        gap: 7px;
    }

    .field-group label {
        color: #334155;
        font-size: 0.9rem;
        font-weight: 600;
    }

    .field-group .req {
        color: #dc2626;
    }

    .form-control {
        width: 100%;
        padding: 12px 14px;
        border-radius: 10px;
        border: 1px solid #d7e0ea;
        background: #fff;
        color: #0f172a;
        font-size: 0.96rem;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

    .form-control:focus {
        outline: none;
        border-color: #2563eb;
        box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.12);
    }

    .text-danger {
        color: #dc2626;
        font-size: 0.82rem;
        margin-top: 4px;
    }

    .sitting-panel {
        padding: 18px;
        border: 1px solid #d9e6f2;
        border-radius: 14px;
        background: #f8fbff;
        margin-bottom: 22px;
    }

    .results-card {
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        overflow: hidden;
        margin-bottom: 10px;
    }

    .results-header,
    .result-row {
        display: grid;
        grid-template-columns: 2.2fr 1.1fr 1.1fr 42px;
        gap: 12px;
        align-items: end;
    }

    .result-row .field-group label {
        display: none;
    }

    .results-header {
        padding: 14px 18px;
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
        color: #475569;
        font-size: 0.82rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .result-row {
        padding: 14px 18px;
        border-bottom: 1px solid #eef2f7;
    }

    .result-row:last-child {
        border-bottom: none;
    }

    .subject-cell {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .row-badge {
        width: 30px;
        height: 30px;
        border-radius: 999px;
        background: rgba(37, 99, 235, 0.1);
        color: #1d4ed8;
        font-size: 0.82rem;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .results-note {
        color: #64748b;
        font-size: 0.88rem;
        line-height: 1.6;
        margin-bottom: 28px;
    }

    .locked-select {
        pointer-events: none;
        background: #f8fafc;
        color: #64748b;
    }

    .file-upload-input {
        position: absolute;
        width: 0.1px;
        height: 0.1px;
        opacity: 0;
        overflow: hidden;
        z-index: -1;
    }

    .file-upload-label {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 22px 20px;
        border: 2px dashed #d0d7e2;
        border-radius: 14px;
        background: #f8fafc;
        cursor: pointer;
        transition: all 0.25s;
    }

    .file-upload-label:hover {
        border-color: #2563eb;
        background: #eef5ff;
    }

    .file-upload-label.has-file {
        border-style: solid;
        border-color: #16a34a;
        background: #f0fdf4;
    }

    .upload-icon {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
        color: #fff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .upload-text h4 {
        margin: 0 0 4px;
        color: #1e293b;
        font-size: 0.96rem;
        font-weight: 700;
    }

    .upload-text p {
        margin: 0;
        color: #64748b;
        font-size: 0.84rem;
    }

    .upload-badge {
        margin-left: auto;
        padding: 6px 12px;
        border-radius: 999px;
        background: #2563eb;
        color: #fff;
        font-size: 0.77rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .file-upload-label.has-file .upload-badge,
    .file-upload-label.has-file .upload-icon {
        background: linear-gradient(135deg, #16a34a 0%, #15803d 100%);
    }

    .file-preview {
        display: none;
        margin-top: 12px;
        padding: 14px 16px;
        border-radius: 12px;
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
        color: #166534;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .file-preview.show {
        display: flex;
    }

    .preview-name {
        font-weight: 700;
    }

    .preview-size {
        color: #15803d;
        font-size: 0.83rem;
    }

    .remove-file {
        border: 1px solid #dc2626;
        background: #fff;
        color: #dc2626;
        border-radius: 10px;
        padding: 8px 14px;
        font-weight: 600;
        cursor: pointer;
    }

    .form-actions {
        margin-top: 34px;
        padding-top: 24px;
        border-top: 1px solid #e2e8f0;
        display: flex;
        justify-content: space-between;
        gap: 12px;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 13px 24px;
        border-radius: 10px;
        border: none;
        text-decoration: none;
        font-weight: 700;
        cursor: pointer;
    }

    .btn-back {
        background: #f1f5f9;
        color: #334155;
        border: 1px solid #d7e0ea;
    }

    .btn-submit {
        background: linear-gradient(135deg, #005bbb 0%, #003b78 100%);
        color: #fff;
    }

    .btn-submit.loading .btn-arrow {
        display: none;
    }

    .btn-submit .spinner {
        display: none;
        width: 16px;
        height: 16px;
        border: 2px solid rgba(255,255,255,0.35);
        border-top-color: #fff;
        border-radius: 999px;
        animation: spin 0.8s linear infinite;
    }

    .btn-submit.loading .spinner {
        display: inline-block;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    @@media (max-width: 768px) {
        .registration-shell {
            padding: 20px 8px;
        }

        .registration-header,
        .form-body,
        .progress-steps {
            padding-left: 16px;
            padding-right: 16px;
        }

        .progress-steps {
            padding: 18px 12px 16px;
        }

        .step-connector {
            max-width: 35px;
        }

        .step-label {
            font-size: 0.75rem;
        }

        .form-actions {
            flex-direction: column-reverse;
            gap: 10px;
        }

        .btn {
            width: 100%;
        }

        .file-upload-label {
            flex-wrap: wrap;
            padding: 16px;
        }

        .upload-badge {
            margin-left: 0;
        }

        .results-header {
            display: none !important;
        }

        .result-row {
            display: grid !important;
            grid-template-columns: 1fr 1fr !important;
            gap: 10px !important;
            padding: 14px !important;
            border-bottom: 6px solid #f1f5f9 !important;
        }

        .result-row .field-group label {
            display: block !important;
            font-size: 0.8rem;
            margin-bottom: 4px;
            color: #475569;
        }

        .result-row .field-group:nth-child(1) {
            grid-column: span 2 !important;
        }

        .result-row .field-group:nth-child(2) {
            grid-column: 1 !important;
        }

        .result-row .field-group:nth-child(3) {
            grid-column: 2 !important;
        }

        .result-row .btn-remove-row {
            grid-column: span 2 !important;
            width: 100% !important;
            height: 38px !important;
            font-size: 0.85rem !important;
            margin-top: 4px;
        }

        .result-row .btn-remove-row::after {
            content: " Remove Subject";
        }
    }

    .btn-add-row {
        background: #f1f5f9;
        color: #0f172a;
        border: 1px dashed #cbd5e1;
        padding: 10px 16px;
        border-radius: 10px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-top: 15px;
        transition: all 0.2s;
    }
    .btn-add-row:hover {
        background: #e2e8f0;
        border-color: #94a3b8;
    }
    .btn-remove-row {
        background: #fee2e2;
        color: #ef4444;
        border: none;
        padding: 10px 14px;
        border-radius: 10px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 2px;
    }
    .btn-remove-row:hover {
        background: #fecaca;
    }

    .locked-select {
        background-color: #f8fafc;
        cursor: not-allowed;
    }
</style>

<div class="registration-shell">
    <div class="registration-card">
        <div class="registration-header">
            <h1>Student Registration</h1>
            <p>Enter your O'Level results manually and upload your passport photograph to continue to payment.</p>
        </div>

        <div class="progress-steps">
            <div class="step completed">
                <div class="step-number">
                    <svg width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425a.267.267 0 0 1 .02-.022z"/>
                    </svg>
                </div>
                <div class="step-label">Personal<br>Details</div>
            </div>
            <div class="step-connector done"></div>
            <div class="step active">
                <div class="step-number">2</div>
                <div class="step-label">Results &amp;<br>Documents</div>
            </div>
            <div class="step-connector"></div>
            <div class="step">
                <div class="step-number">3</div>
                <div class="step-label">Payment &amp;<br>Submit</div>
            </div>
        </div>

        <div class="form-body">
            <div class="info-banner">
                Enter the examination details for the result you are using, then add each subject and grade one by one. If you are combining two results, switch the sitting type to two sittings and fill both exam numbers and years.
            </div>

            <form asp-action="StepTwoRegistration" method="post" enctype="multipart/form-data" id="step2Form">
                <h3 class="section-title">Examination Details</h3>

                <div class="sitting-panel">
                    <div class="field-grid">
                        <div class="field-group">
                            <label asp-for="waecModel.SittingType">Result Type <span class="req">*</span></label>
                            <select asp-for="waecModel.SittingType" class="form-control" id="sittingType">
                                <option value="@((byte)ResultSittingType.OneSitting)">One Sitting</option>
                                <option value="@((byte)ResultSittingType.TwoSittings)">Two Sittings</option>
                            </select>
                            <span asp-validation-for="waecModel.SittingType" class="text-danger"></span>
                        </div>
                        <div class="field-group">
                            <label asp-for="waecModel.ExaminationBody">First Sitting Exam Body <span class="req">*</span></label>
                            <select asp-for="waecModel.ExaminationBody" class="form-control" id="firstExamBody" required>
                                <option value="">Select Exam Body</option>
                                <option value="WAEC">WAEC</option>
                                <option value="NECO">NECO</option>
                                <option value="NABTEB">NABTEB</option>
                                <option value="GCE">GCE</option>
                                <option value="JUPEB">JUPEB</option>
                                <option value="IJMB">IJMB</option>
                            </select>
                            <span asp-validation-for="waecModel.ExaminationBody" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="field-grid">
                        <div class="field-group">
                            <label asp-for="waecModel.ExaminationNumber">First Sitting Examination Number <span class="req">*</span></label>
                            <input asp-for="waecModel.ExaminationNumber" class="form-control" placeholder="Enter first sitting exam number" required />
                            <span asp-validation-for="waecModel.ExaminationNumber" class="text-danger"></span>
                        </div>
                        <div class="field-group">
                            <label asp-for="waecModel.ExaminationYear">First Sitting Examination Year <span class="req">*</span></label>
                            <input asp-for="waecModel.ExaminationYear" class="form-control" placeholder="e.g. 2024" maxlength="4" required />
                            <span asp-validation-for="waecModel.ExaminationYear" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="field-grid" id="secondSittingFields">
                        <div class="field-group">
                            <label asp-for="waecModel.SecondExaminationBody">Second Sitting Exam Body</label>
                            <select asp-for="waecModel.SecondExaminationBody" class="form-control" id="secondExamBody">
                                <option value="">Select Exam Body</option>
                                <option value="WAEC">WAEC</option>
                                <option value="NECO">NECO</option>
                                <option value="NABTEB">NABTEB</option>
                                <option value="GCE">GCE</option>
                                <option value="JUPEB">JUPEB</option>
                                <option value="IJMB">IJMB</option>
                            </select>
                            <span asp-validation-for="waecModel.SecondExaminationBody" class="text-danger"></span>
                        </div>
                        <div class="field-group">
                            <label asp-for="waecModel.SecondExaminationNumber">Second Sitting Examination Number</label>
                            <input asp-for="waecModel.SecondExaminationNumber" class="form-control" placeholder="Enter second sitting exam number" />
                            <span asp-validation-for="waecModel.SecondExaminationNumber" class="text-danger"></span>
                        </div>
                        <div class="field-group">
                            <label asp-for="waecModel.SecondExaminationYear">Second Sitting Examination Year</label>
                            <input asp-for="waecModel.SecondExaminationYear" class="form-control" placeholder="e.g. 2023" maxlength="4" />
                            <span asp-validation-for="waecModel.SecondExaminationYear" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="results-card">
                    <div class="results-header">
                        <div>Subject</div>
                        <div>Grade</div>
                        <div>Sitting</div>
                        <div style="width: 40px;"></div>
                    </div>

                    <div id="subjectsContainer">
                        @{
                            var existingResults = Model.waecModel.SubjectResults ?? new List<WaecSubjectResultEntryModel>();
                            if (!existingResults.Any(r => !string.IsNullOrEmpty(r.Subject)))
                            {
                                existingResults = new List<WaecSubjectResultEntryModel> { new WaecSubjectResultEntryModel() };
                            }
                        }
                        @for (var i = 0; i < existingResults.Count; i++)
                        {
                            <div class="result-row">
                                <div class="field-group">
                                    <label>Subject</label>
                                    <div class="subject-cell">
                                        <span class="row-badge">@(i + 1)</span>
                                        <select name="waecModel.SubjectResults[@i].Subject" class="form-control subject-select" data-selected-val="@existingResults[i].Subject" required>
                                            <option value="">Select subject</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="field-group">
                                    <label>Grade</label>
                                    <select name="waecModel.SubjectResults[@i].Grade" class="form-control grade-select" data-selected-val="@existingResults[i].Grade" required>
                                        <option value="">Select grade</option>
                                    </select>
                                </div>

                                <div class="field-group">
                                    <label>Sitting</label>
                                    <select name="waecModel.SubjectResults[@i].SittingNumber" class="form-control result-sitting-select" required>
                                        <option value="1" selected="@(existingResults[i].SittingNumber == 1)">Sitting 1</option>
                                        <option value="2" selected="@(existingResults[i].SittingNumber == 2)">Sitting 2</option>
                                    </select>
                                </div>

                                <button type="button" class="btn-remove-row" onclick="removeRow(this)">✕</button>
                            </div>
                        }
                    </div>

                    <div class="dynamic-actions-row">
                        <button type="button" class="btn-add-row" id="addSubjectBtn">
                            <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/>
                            </svg>
                            Add Subject Row
                        </button>
                    </div>
                </div>

                <div class="results-note">
                    Fill in the subjects and grades. If you are using JUPEB/IJMB, select it as your exam body to see the correct subjects and grade scale (A, B, C, D, E, F).
                </div>

                <h3 class="section-title">Passport Photograph</h3>

                <div class="tips-banner">
                    Use a recent passport on a plain white or light blue background. Supported formats are JPG and PNG. Large images will be automatically compressed to save space.
                </div>

                <div class="field-group">
                    <label asp-for="passportModel.PassportPhoto">Passport Photograph <span class="req">*</span></label>
                    <input type="file" asp-for="passportModel.PassportPhoto" class="file-upload-input" id="passportUpload" accept=".jpg,.jpeg,.png" />
                    <label for="passportUpload" class="file-upload-label" id="passportLabel">
                        <span class="upload-icon">
                            <svg width="22" height="22" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M10.5 8.5a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0z" />
                                <path d="M2 4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-1.172a2 2 0 0 1-1.414-.586l-.828-.828A2 2 0 0 0 9.172 2H6.828a2 2 0 0 0-1.414.586l-.828.828A2 2 0 0 1 3.172 4H2z" />
                            </svg>
                        </span>
                        <span class="upload-text">
                            <h4 id="passportTitle">Click to upload passport photo</h4>
                            <p>Supported formats: JPG, PNG</p>
                        </span>
                        <span class="upload-badge" id="passportBadge">Browse</span>
                    </label>
                    <div class="file-preview" id="passportPreview">
                        <div>
                            <div class="preview-name" id="passportFileName">passport.jpg</div>
                            <div class="preview-size" id="passportFileSize">0 KB</div>
                        </div>
                        <button type="button" class="remove-file" id="removePassport">Remove</button>
                    </div>
                    <span asp-validation-for="passportModel.PassportPhoto" class="text-danger"></span>
                </div>

                <div class="form-actions">
                    <a asp-action="StepOneRegistration" class="btn btn-back">Back to Step 1</a>
                    <button type="submit" class="btn btn-submit" id="submitBtn">
                        <span class="btn-text">Proceed to Payment</span>
                        <svg class="btn-arrow" width="15" height="15" fill="currentColor" viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8z" />
                        </svg>
                        <span class="spinner"></span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="https://cdnjs.cloudflare.com/ajax/libs/compressorjs/1.2.1/compressor.min.js" integrity="sha512-MgYeYFj8R3S6rvZyd/7yV88xGZ1Z0yQfEitRZiTewm8rKofGvBvHnB3z5/Oixdya1x1fGexC24Bf1k1z2b0Bpg==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>

    <script>
        const sittingType = document.getElementById('sittingType');
        const secondSittingFields = document.getElementById('secondSittingFields');
        const firstExamBody = document.getElementById('firstExamBody');
        const secondExamBody = document.getElementById('secondExamBody');
        const subjectsContainer = document.getElementById('subjectsContainer');
        const addSubjectBtn = document.getElementById('addSubjectBtn');
        const passportUpload = document.getElementById('passportUpload');
        const passportLabel = document.getElementById('passportLabel');
        const passportPreview = document.getElementById('passportPreview');
        const passportFileName = document.getElementById('passportFileName');
        const passportFileSize = document.getElementById('passportFileSize');
        const passportTitle = document.getElementById('passportTitle');
        const passportBadge = document.getElementById('passportBadge');
        const removePassport = document.getElementById('removePassport');

        const oLevelSubjects = [
            "Mathematics", "English Language", "Agricultural Science", "Biology", "Chemistry", "Civic Education", "Commerce",
            "Computer Studies", "CRK/IRK", "Data Processing", "Economics", "Financial Accounting",
            "Food and Nutrition", "French", "Further Mathematics", "Geography", "Government",
            "Hausa", "Igbo", "Literature in English", "Marketing", "Physical Education",
            "Physics", "Technical Drawing", "Yoruba", "Book Keeping", "Office Practice",
            "Animal Husbandry", "Fisheries", "Store Management", "Insurance", "Salesmanship",
            "Dyeing & Bleaching", "Catering Craft Practice", "Garment Making"
        ];
        const finalOLevel = ["English Language", "Mathematics", ...oLevelSubjects.filter(s => s !== "Mathematics" && s !== "English Language").sort()];

        const aLevelSubjects = [
            "Mathematics", "Physics", "Chemistry", "Biology", "Economics", "Government",
            "Literature in English", "Geography", "Accounting", "Business Studies", "History", "Sociology"
        ].sort();

        const oLevelGrades = ["A1", "B2", "B3", "C4", "C5", "C6", "D7", "E8", "F9"];
        const aLevelGrades = ["A", "B", "C", "D", "E", "F"];

        function getExamBodyForSitting(sittingNumber) {
            if (sittingNumber === 2) {
                return secondExamBody.value || 'WAEC';
            }
            return firstExamBody.value || 'WAEC';
        }

        function updateDropdownsForRow(row) {
            const sittingSelect = row.querySelector('.result-sitting-select');
            const subjectSelect = row.querySelector('.subject-select');
            const gradeSelect = row.querySelector('.grade-select');

            const sittingVal = parseInt(sittingSelect.value) || 1;
            const examBody = getExamBodyForSitting(sittingVal);
            const isALevel = examBody === 'JUPEB' || examBody === 'IJMB';

            const subjects = isALevel ? aLevelSubjects : finalOLevel;
            const grades = isALevel ? aLevelGrades : oLevelGrades;

            const selectedSubject = subjectSelect.getAttribute('data-selected-val') || subjectSelect.value;
            const selectedGrade = gradeSelect.getAttribute('data-selected-val') || gradeSelect.value;

            // Clear attribute after first load so users can change them
            subjectSelect.removeAttribute('data-selected-val');
            gradeSelect.removeAttribute('data-selected-val');

            subjectSelect.innerHTML = '<option value="">Select subject</option>';
            subjects.forEach(sub => {
                const opt = document.createElement('option');
                opt.value = sub;
                opt.textContent = sub;
                if (sub === selectedSubject) opt.selected = true;
                subjectSelect.appendChild(opt);
            });

            gradeSelect.innerHTML = '<option value="">Select grade</option>';
            grades.forEach(g => {
                const opt = document.createElement('option');
                opt.value = g;
                opt.textContent = g;
                if (g === selectedGrade) opt.selected = true;
                gradeSelect.appendChild(opt);
            });
        }

        function updateAllRowDropdowns() {
            document.querySelectorAll('.result-row').forEach(row => {
                updateDropdownsForRow(row);
            });
        }

        function reindexRows() {
            const rows = document.querySelectorAll('.result-row');
            rows.forEach((row, index) => {
                const badge = row.querySelector('.row-badge');
                if (badge) badge.textContent = index + 1;

                const subjectSelect = row.querySelector('.subject-select');
                if (subjectSelect) {
                    subjectSelect.name = `waecModel.SubjectResults[${index}].Subject`;
                }

                const gradeSelect = row.querySelector('.grade-select');
                if (gradeSelect) {
                    gradeSelect.name = `waecModel.SubjectResults[${index}].Grade`;
                }

                const sittingSelect = row.querySelector('.result-sitting-select');
                if (sittingSelect) {
                    sittingSelect.name = `waecModel.SubjectResults[${index}].SittingNumber`;
                }
            });
        }

        function removeRow(btn) {
            const rows = document.querySelectorAll('.result-row');
            if (rows.length <= 1) {
                alert('You must enter at least one subject result.');
                return;
            }
            btn.closest('.result-row').remove();
            reindexRows();
        }

        function addRow() {
            const index = document.querySelectorAll('.result-row').length;
            const newRow = document.createElement('div');
            newRow.className = 'result-row';
            newRow.innerHTML = `
                <div class="field-group">
                    <label>Subject</label>
                    <div class="subject-cell">
                        <span class="row-badge">${index + 1}</span>
                        <select name="waecModel.SubjectResults[${index}].Subject" class="form-control subject-select" required>
                            <option value="">Select subject</option>
                        </select>
                    </div>
                </div>
                <div class="field-group">
                    <label>Grade</label>
                    <select name="waecModel.SubjectResults[${index}].Grade" class="form-control grade-select" required>
                        <option value="">Select grade</option>
                    </select>
                </div>
                <div class="field-group">
                    <label>Sitting</label>
                    <select name="waecModel.SubjectResults[${index}].SittingNumber" class="form-control result-sitting-select" required>
                        <option value="1">Sitting 1</option>
                        <option value="2">Sitting 2</option>
                    </select>
                </div>
                <button type="button" class="btn-remove-row" onclick="removeRow(this)">✕</button>
            `;
            subjectsContainer.appendChild(newRow);

            const sittingSelect = newRow.querySelector('.result-sitting-select');
            sittingSelect.addEventListener('change', () => {
                updateDropdownsForRow(newRow);
            });

            // Adjust sitting select restriction
            const isTwoSittings = sittingType.value === '@((byte)ResultSittingType.TwoSittings)';
            if (!isTwoSittings) {
                sittingSelect.value = '1';
                sittingSelect.classList.add('locked-select');
                sittingSelect.style.pointerEvents = 'none';
            }

            updateDropdownsForRow(newRow);
            reindexRows();
        }

        function updateSittingMode() {
            const isTwoSittings = sittingType.value === '@((byte)ResultSittingType.TwoSittings)';
            secondSittingFields.style.display = isTwoSittings ? 'grid' : 'none';

            const secondExamBodySelect = document.getElementById('secondExamBody');
            if (isTwoSittings) {
                secondExamBodySelect.setAttribute('required', 'required');
            } else {
                secondExamBodySelect.removeAttribute('required');
                secondExamBodySelect.value = '';
            }

            document.querySelectorAll('.result-sitting-select').forEach(select => {
                if (!isTwoSittings) {
                    select.value = '1';
                    select.classList.add('locked-select');
                    select.style.pointerEvents = 'none';
                } else {
                    select.classList.remove('locked-select');
                    select.style.pointerEvents = 'auto';
                }
                const row = select.closest('.result-row');
                if (row) updateDropdownsForRow(row);
            });
        }

        addSubjectBtn.addEventListener('click', addRow);

        sittingType.addEventListener('change', updateSittingMode);
        firstExamBody.addEventListener('change', updateAllRowDropdowns);
        secondExamBody.addEventListener('change', updateAllRowDropdowns);

        // Bind existing row sitting changes
        document.querySelectorAll('.result-sitting-select').forEach(select => {
            select.addEventListener('change', function() {
                updateDropdownsForRow(this.closest('.result-row'));
            });
        });

        // Initialize existing rows on load
        document.querySelectorAll('.result-row').forEach(row => {
            updateDropdownsForRow(row);
        });
        updateSittingMode();

        function formatFileSize(bytes) {
            if (!bytes) return '0 KB';
            const kb = bytes / 1024;
            if (kb < 1024) return `${kb.toFixed(1)} KB`;
            return `${(kb / 1024).toFixed(1)} MB`;
        }

        function clearPassportFile() {
            passportUpload.value = '';
            passportLabel.classList.remove('has-file');
            passportPreview.classList.remove('show');
            passportTitle.textContent = 'Click to upload passport photo';
            passportBadge.textContent = 'Browse';
        }

        passportUpload?.addEventListener('change', function () {
            const file = passportUpload.files[0];
            if (!file) {
                clearPassportFile();
                return;
            }

            const validTypes = ['image/jpeg', 'image/png', 'image/jpg'];
            if (!validTypes.includes(file.type)) {
                alert('Please upload a valid image file (JPG, JPEG, or PNG).');
                clearPassportFile();
                return;
            }

            passportTitle.textContent = 'Compressing image...';
            passportBadge.textContent = 'Wait';

            new Compressor(file, {
                quality: 0.7,
                maxWidth: 800,
                maxHeight: 800,
                success(result) {
                    const compressedFile = new File([result], file.name, {
                        type: result.type,
                        lastModified: Date.now(),
                    });

                    const dataTransfer = new DataTransfer();
                    dataTransfer.items.add(compressedFile);
                    passportUpload.files = dataTransfer.files;

                    passportLabel.classList.add('has-file');
                    passportPreview.classList.add('show');
                    passportFileName.textContent = compressedFile.name;
                    passportFileSize.textContent = formatFileSize(compressedFile.size);
                    passportTitle.textContent = compressedFile.name;
                    passportBadge.textContent = 'Uploaded';
                },
                error(err) {
                    console.error('Compression error:', err.message);
                    alert('An error occurred while processing the image.');
                    clearPassportFile();
                },
            });
        });

        removePassport?.addEventListener('click', clearPassportFile);

        document.getElementById('step2Form')?.addEventListener('submit', function () {
            document.getElementById('submitBtn')?.classList.add('loading');
        });
    </script>
}
