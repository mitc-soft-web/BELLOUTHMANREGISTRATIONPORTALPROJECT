@model Mitc_Registration_Portal.Models.DTOs.Document.DocumentViewModel
@{
    ViewData["Title"] = "Student Registration - Step 2";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .registration-wrapper {
        min-height: 85vh;
        padding: 60px 20px;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
    }

    .registration-container {
        max-width: 900px;
        margin: 0 auto;
        background: #fff;
        border-radius: 15px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
        overflow: hidden;
    }

    .registration-header {
        background: linear-gradient(135deg, #0066cc 0%, #004080 100%);
        color: #fff;
        padding: 40px;
        text-align: center;
    }

    .registration-header h1 {
        font-size: 2em;
        margin-bottom: 10px;
    }

    .registration-header p {
        opacity: 0.95;
        font-size: 1.05em;
    }

    .progress-steps {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 30px 40px;
        background: #f8f9fa;
        border-bottom: 1px solid #e0e0e0;
    }

    .step {
        display: flex;
        flex-direction: column;
        align-items: center;
        position: relative;
        flex: 1;
        max-width: 200px;
    }

    .step-number {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        background: #e0e0e0;
        color: #999;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 1.1em;
        margin-bottom: 10px;
        transition: all 0.3s;
        z-index: 2;
    }

    .step.completed .step-number {
        background: #28a745;
        color: #fff;
    }

    .step.active .step-number {
        background: #0066cc;
        color: #fff;
        box-shadow: 0 0 0 4px rgba(0, 102, 204, 0.2);
    }

    .step-label {
        font-size: 0.9em;
        color: #666;
        font-weight: 500;
    }

    .step.active .step-label {
        color: #0066cc;
        font-weight: 600;
    }

    .step.completed .step-label {
        color: #28a745;
    }

    .step-line {
        position: absolute;
        top: 22px;
        left: 50%;
        width: 100%;
        height: 3px;
        background: #e0e0e0;
        z-index: 1;
    }

    .step.completed .step-line {
        background: #28a745;
    }

    .step:last-child .step-line {
        display: none;
    }

    .form-content {
        padding: 50px 40px;
    }

    .section-title {
        color: #0066cc;
        font-size: 1.4em;
        margin-bottom: 25px;
        padding-bottom: 10px;
        border-bottom: 2px solid #f0f0f0;
    }

    .form-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 25px;
        margin-bottom: 25px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
    }

    .form-group.full-width {
        grid-column: 1 / -1;
    }

    .form-group label {
        color: #333;
        font-weight: 600;
        margin-bottom: 8px;
        font-size: 0.95em;
    }

    .form-group label span {
        color: #dc3545;
    }

    .form-control {
        width: 100%;
        padding: 12px 15px;
        border: 2px solid #e0e0e0;
        border-radius: 8px;
        font-size: 1em;
        transition: all 0.3s;
        outline: none;
        background: #fff;
    }

    .form-control:focus {
        border-color: #0066cc;
        box-shadow: 0 0 0 3px rgba(0, 102, 204, 0.1);
    }

    .file-upload-wrapper {
        position: relative;
        overflow: hidden;
        display: inline-block;
        width: 100%;
    }

    .file-upload-label {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        padding: 40px 20px;
        border: 2px dashed #e0e0e0;
        border-radius: 8px;
        background: #f8f9fa;
        cursor: pointer;
        transition: all 0.3s;
        text-align: center;
    }

    .file-upload-label:hover {
        border-color: #0066cc;
        background: #f0f6ff;
    }

    .file-upload-label.has-file {
        border-color: #28a745;
        background: #f0f8f4;
    }

    .file-upload-input {
        position: absolute;
        width: 0.1px;
        height: 0.1px;
        opacity: 0;
        overflow: hidden;
        z-index: -1;
    }

    .upload-icon {
        width: 50px;
        height: 50px;
        background: linear-gradient(135deg, #0066cc 0%, #004080 100%);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
    }

    .upload-text h4 {
        color: #333;
        margin-bottom: 5px;
        font-size: 1em;
    }

    .upload-text p {
        color: #999;
        font-size: 0.85em;
        margin: 0;
    }

    .file-preview {
        margin-top: 15px;
        padding: 15px;
        background: #f8f9fa;
        border-radius: 8px;
        display: none;
    }

    .file-preview.show {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .file-info {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .file-icon {
        width: 40px;
        height: 40px;
        background: #28a745;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
    }

    .file-details h5 {
        margin: 0;
        color: #333;
        font-size: 0.95em;
    }

    .file-details p {
        margin: 0;
        color: #999;
        font-size: 0.85em;
    }

    .remove-file {
        background: #dc3545;
        color: #fff;
        border: none;
        padding: 8px 16px;
        border-radius: 6px;
        cursor: pointer;
        font-size: 0.9em;
        transition: all 0.3s;
    }

    .remove-file:hover {
        background: #c82333;
    }

    .text-danger {
        color: #dc3545;
        font-size: 0.875em;
        margin-top: 5px;
    }

    .alert {
        padding: 15px 20px;
        border-radius: 8px;
        margin-bottom: 25px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .alert-info {
        background: #e7f3ff;
        border: 1px solid #b3d9ff;
        color: #004085;
    }

    .form-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 40px;
        padding-top: 30px;
        border-top: 2px solid #f0f0f0;
    }

    .btn {
        padding: 14px 35px;
        border: none;
        border-radius: 8px;
        font-size: 1.05em;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
    }

    .btn-back {
        background: #6c757d;
        color: #fff;
    }

    .btn-back:hover {
        background: #5a6268;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(108, 117, 125, 0.3);
    }

    .btn-proceed {
        background: #0066cc;
        color: #fff;
    }

    .btn-proceed:hover {
        background: #004080;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(0, 102, 204, 0.4);
    }

    .info-box {
        background: #fff3cd;
        border: 1px solid #ffc107;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 25px;
        display: flex;
        align-items: start;
        gap: 12px;
    }

    .info-box svg {
        flex-shrink: 0;
        margin-top: 2px;
    }

    @@media (max-width: 768px) {
        .registration-wrapper {
            padding: 30px 15px;
        }

        .registration-header {
            padding: 30px 20px;
        }

        .registration-header h1 {
            font-size: 1.5em;
        }

        .form-content {
            padding: 30px 20px;
        }

        .progress-steps {
            padding: 20px 15px;
            overflow-x: auto;
        }

        .step {
            min-width: 100px;
        }

        .step-number {
            width: 40px;
            height: 40px;
            font-size: 1em;
        }

        .step-label {
            font-size: 0.8em;
        }

        .form-row {
            grid-template-columns: 1fr;
            gap: 20px;
        }

        .form-actions {
            flex-direction: column;
            gap: 15px;
        }

        .btn {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<div class="registration-wrapper">
    <div class="registration-container">
        <div class="registration-header">
            <h1>Student Registration</h1>
            <p>Upload your academic credentials and passport photograph</p>
        </div>

        <div class="progress-steps">
            <div class="step completed">
                <div class="step-number">✓</div>
                <div class="step-label">Personal Info</div>
                <div class="step-line"></div>
            </div>
            <div class="step active">
                <div class="step-number">2</div>
                <div class="step-label">Documents</div>
                <div class="step-line"></div>
            </div>
            <div class="step">
                <div class="step-number">3</div>
                <div class="step-label">Guardian Info</div>
                <div class="step-line"></div>
            </div>
            <div class="step">
                <div class="step-number">4</div>
                <div class="step-label">Review</div>
            </div>
        </div>

        <div class="form-content">
            <div class="alert alert-info">
                <svg width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z" />
                    <path d="m8.93 6.588-2.29.287-.082.38.45.083c.294.07.352.176.288.469l-.738 3.468c-.194.897.105 1.319.808 1.319.545 0 1.178-.252 1.465-.598l.088-.416c-.2.176-.492.246-.686.246-.275 0-.375-.193-.304-.533L8.93 6.588zM9 4.5a1 1 0 1 1-2 0 1 1 0 0 1 2 0z" />
                </svg>
                <span>Please upload clear, high-quality documents. Maximum file size: 5MB per document.</span>
            </div>

            <form asp-action="StepTwoRegistration" method="post" enctype="multipart/form-data" id="step2Form">
                <h3 class="section-title">Examination Details (WAEC/NECO)</h3>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="waecModel.ExaminationNumber">
                            Examination Number <span>*</span>
                        </label>
                        <input asp-for="waecModel.ExaminationNumber"
                               class="form-control"
                               placeholder="Enter examination number"
                               required />
                        <span asp-validation-for="waecModel.ExaminationNumber" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="waecModel.ExaminationYear">
                            Examination Year <span>*</span>
                        </label>
                        <input asp-for="waecModel.ExaminationYear"
                               class="form-control"
                               placeholder="e.g., 2023"
                               type="text"
                               maxlength="4"
                               required />
                        <span asp-validation-for="waecModel.ExaminationYear" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group full-width">
                    <label asp-for="waecModel.WaecCertificate">
                        WAEC/NECO Certificate <span>*</span>
                    </label>
                    <div class="file-upload-wrapper">
                        <input type="file"
                               asp-for="waecModel.WaecCertificate"
                               class="file-upload-input"
                               id="waecUpload"
                               accept=".pdf,.jpg,.jpeg,.png"
                               required />
                        <label for="waecUpload" class="file-upload-label" id="waecLabel">
                            <div class="upload-icon">
                                <svg width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z" />
                                    <path d="M7.646 1.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1-.708.708L8.5 2.707V11.5a.5.5 0 0 1-1 0V2.707L5.354 4.854a.5.5 0 1 1-.708-.708l3-3z" />
                                </svg>
                            </div>
                            <div class="upload-text">
                                <h4>Click to upload WAEC/NECO Certificate</h4>
                                <p>Supported formats: PDF, JPG, PNG (Max: 5MB)</p>
                            </div>
                        </label>
                    </div>
                    <div class="file-preview" id="waecPreview">
                        <div class="file-info">
                            <div class="file-icon">
                                <svg width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M14 4.5V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h5.5L14 4.5zm-3 0A1.5 1.5 0 0 1 9.5 3V1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V4.5h-2z" />
                                </svg>
                            </div>
                            <div class="file-details">
                                <h5 id="waecFileName">Certificate.pdf</h5>
                                <p id="waecFileSize">0 KB</p>
                            </div>
                        </div>
                        <button type="button" class="remove-file" onclick="removeFile('waec')">Remove</button>
                    </div>
                    <span asp-validation-for="waecModel.WaecCertificate" class="text-danger"></span>
                </div>

                <h3 class="section-title" style="margin-top: 40px;">Passport Photograph</h3>

                <div class="info-box">
                    <svg width="20" height="20" fill="#856404" viewBox="0 0 16 16">
                        <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z" />
                    </svg>
                    <div>
                        <strong>Photo Requirements:</strong> White or light blue background, recent photo (not older than 6 months), formal attire, clear face visible, no accessories covering face.
                    </div>
                </div>

                <div class="form-group full-width">
                    <label asp-for="passportModel.PassportPhoto">
                        Passport Photograph <span>*</span>
                    </label>
                    <div class="file-upload-wrapper">
                        <input type="file"
                               asp-for="passportModel.PassportPhoto"
                               class="file-upload-input"
                               id="passportUpload"
                               accept=".jpg,.jpeg,.png"
                               required />
                        <label for="passportUpload" class="file-upload-label" id="passportLabel">
                            <div class="upload-icon">
                                <svg width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M10.5 8.5a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0z" />
                                    <path d="M2 4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-1.172a2 2 0 0 1-1.414-.586l-.828-.828A2 2 0 0 0 9.172 2H6.828a2 2 0 0 0-1.414.586l-.828.828A2 2 0 0 1 3.172 4H2zm.5 2a.5.5 0 1 1 0-1 .5.5 0 0 1 0 1zm9 2.5a3.5 3.5 0 1 1-7 0 3.5 3.5 0 0 1 7 0z" />
                                </svg>
                            </div>
                            <div class="upload-text">
                                <h4>Click to upload Passport Photo</h4>
                                <p>Supported formats: JPG, PNG (Max: 5MB)</p>
                            </div>
                        </label>
                    </div>
                    <div class="file-preview" id="passportPreview">
                        <div class="file-info">
                            <div class="file-icon">
                                <svg width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M6.002 5.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0z" />
                                    <path d="M2.002 1a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V3a2 2 0 0 0-2-2h-12zm12 1a1 1 0 0 1 1 1v6.5l-3.777-1.947a.5.5 0 0 0-.577.093l-3.71 3.71-2.66-1.772a.5.5 0 0 0-.63.062L1.002 12V3a1 1 0 0 1 1-1h12z" />
                                </svg>
                            </div>
                            <div class="file-details">
                                <h5 id="passportFileName">Passport.jpg</h5>
                                <p id="passportFileSize">0 KB</p>
                            </div>
                        </div>
                        <button type="button" class="remove-file" onclick="removeFile('passport')">Remove</button>
                    </div>
                    <span asp-validation-for="passportModel.PassportPhoto" class="text-danger"></span>
                </div>

                <div class="form-actions">
                    <a asp-action="StepOneRegistration" asp-controller="Account" class="btn btn-back">
                        <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z" />
                        </svg>
                        Back to Step 1
                    </a>
                    <button type="submit" class="btn btn-proceed">
                        Proceed to Next Step
                        <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8z" />
                        </svg>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // WAEC Certificate Upload
        document.getElementById('waecUpload')?.addEventListener('change', function(e) {
            handleFileUpload(e, 'waec');
        });

        // Passport Photo Upload
        document.getElementById('passportUpload')?.addEventListener('change', function(e) {
            handleFileUpload(e, 'passport');
        });

        function handleFileUpload(event, type) {
            const file = event.target.files[0];
            if (!file) return;

            const maxSize = 5 * 1024 * 1024; // 5MB
            if (file.size > maxSize) {
                alert('File size exceeds 5MB. Please upload a smaller file.');
                event.target.value = '';
                return;
            }

            const label = document.getElementById(`${type}Label`);
            const preview = document.getElementById(`${type}Preview`);
            const fileName = document.getElementById(`${type}FileName`);
            const fileSize = document.getElementById(`${type}FileSize`);

            label.classList.add('has-file');
            preview.classList.add('show');
            fileName.textContent = file.name;
            fileSize.textContent = formatFileSize(file.size);
        }

        function removeFile(type) {
            const input = document.getElementById(`${type}Upload`);
            const label = document.getElementById(`${type}Label`);
            const preview = document.getElementById(`${type}Preview`);

            input.value = '';
            label.classList.remove('has-file');
            preview.classList.remove('show');
        }

        function formatFileSize(bytes) {
            if (bytes === 0) return '0 Bytes';
            const k = 1024;
            const sizes = ['Bytes', 'KB', 'MB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return Math.round(bytes / Math.pow(k, i) * 100) / 100 + ' ' + sizes[i];
        }

        // Form submission with loading state
        document.getElementById('step2Form')?.addEventListener('submit', function() {
            const btn = document.querySelector('.btn-proceed');
            btn.innerHTML = '<span>Uploading...</span>';
            btn.disabled = true;
        });
    </script>
}