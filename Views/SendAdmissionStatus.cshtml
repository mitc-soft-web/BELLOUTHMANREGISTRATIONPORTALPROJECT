@model Mitc_Registration_Portal.Messaging.Models.SendAdmissionUpdate
@{
    Layout = null;
    var isAdmitted = Model.Status == "Admitted";
    var isRejected = Model.Status == "Rejected";
    var title = isAdmitted ? "Admission Offer" : (isRejected ? "Application Decision Notice" : "Application Update");
    var departmentName = string.IsNullOrWhiteSpace(Model.DepartmentName) ? "your assigned department" : Model.DepartmentName;
}
<!DOCTYPE html>
<html lang="en">
<!DOCTYPE html>
<html lang="en">
<body style="margin:0; background:#f8fafc; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">
<table role="presentation" width="100%" style="background:#f8fafc; padding:40px 15px;">
  <tr>
    <td align="center">
      <table role="presentation" width="600" style="background:#ffffff; border-radius:12px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);">

        <tr>
          <td style="padding:32px 30px 24px; background:#0066cc; border-radius:12px 12px 0 0; text-align:center;">
            <img src="https://tensest-tawna-instructedly.ngrok-free.dev/assets/mitc_logo.png" style="height:50px; margin-bottom:10px;" alt="MITC Logo" />
            <div style="font-size:22px; font-weight:700; color:#ffffff; letter-spacing:-0.025em;">@title</div>
          </td>
        </tr>

        <tr>
          <td style="padding:40px 30px;">
            <p style="font-size:16px; color:#1e293b;">Hello <strong>@Model.Name</strong>,</p>

            @if (isAdmitted)
            {
              <p style="color:#475569; line-height:1.75; font-size:15px;">
                Congratulations! We are pleased to inform you that you have been
                <strong>offered admission</strong> to MITC. Please log in to the student portal
                to accept your admission offer.
              </p>

              <div style="margin:24px 0; padding:18px; background:#eff6ff; border:1px solid #bfdbfe; border-radius:10px;">
                <div style="font-size:13px; color:#475569; text-transform:uppercase; letter-spacing:0.08em; margin-bottom:6px;">
                  Admitted Department
                </div>
                <div style="font-size:18px; font-weight:700; color:#1e3a8a;">
                  @departmentName
                </div>
              </div>
            }
            else if (isRejected)
            {
              <p style="color:#475569; line-height:1.75; font-size:15px;">
                Thank you for applying to MITC. After a careful review of your application,
                we regret to inform you that we are <strong>unable to offer you admission</strong>
                at this time. We encourage you to reapply in the next admission cycle.
              </p>
            }
            else
            {
              <p style="color:#475569; line-height:1.75; font-size:15px;">
                Thank you for applying to MITC. Your application status is currently
                <strong>pending</strong>. Please log in to the portal to monitor updates.
              </p>
            }

            <div style="margin:30px 0; text-align:center;">
              <a href="https://tensest-tawna-instructedly.ngrok-free.dev/"
                 style="background:#0066cc; color:#ffffff; padding:16px 30px; border-radius:8px; font-weight:600; font-size:15px; text-decoration:none; display:inline-block;">
                @Model.ActionText
              </a>
            </div>

            <p style="font-size:12px; color:#94a3b8; text-align:center; margin-top:40px;">
              This is an automated message from the <strong>MITC Lifecycle Engine</strong>.
            </p>
          </td>
        </tr>

      </table>
    </td>
  </tr>
</table>
</body>
</html>
