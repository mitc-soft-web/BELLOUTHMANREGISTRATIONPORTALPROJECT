                </div>
            </div>
        </div>

        <nav>
            <div class="container">
                <div class="logo">
                    <a asp-area="" asp-controller="Student" asp-action="GetAllStudent">
                        <img src="https://mitc.iaaae.org/wp-content/uploads/2024/12/logo3.jpg" alt="MITC Logo">
                    </a>
                </div>
                <ul class="nav-menu" id="navMenu">
                    <li><a asp-area="" asp-controller="Student" asp-action="GetAllStudent">Dashboard</a></li>

                    <li class="has-dropdown">
                        <a href="#students">Students</a>
                        <ul class="dropdown">
                            <li><a asp-area="" asp-controller="Student" asp-action="GetAllStudent">All Students</a></li>
                            @* <li><a asp-area="" asp-controller="Admin" asp-action="AddStudent">Add Student</a></li> *@
                            <li><a asp-area="" asp-controller="Admin" asp-action="StudentAdmissions">Admissions</a></li>
                            <li><a asp-area="" asp-controller="Admin" asp-action="StudentAttendance">Attendance</a></li>
                        </ul>
                    </li>

                    <li class="has-dropdown">
                        <a href="#courses">Department</a>
                        <ul class="dropdown">
                            <li><a asp-area="" asp-controller="Department" asp-action="CreateDepartment">Create Department</a></li>
                            <li><a asp-area="" asp-controller="Department" asp-action="Index">All Departments</a></li>
                        </ul>
                    </li>

                  @*   <li class="has-dropdown">
                        <a href="#instructors">Instructors</a>
                        <ul class="dropdown">
                            <li><a asp-area="" asp-controller="Admin" asp-action="AllInstructors">All Instructors</a></li>
                            <li><a asp-area="" asp-controller="Admin" asp-action="AddInstructor">Add Instructor</a></li>
                            <li><a asp-area="" asp-controller="Admin" asp-action="InstructorSchedule">Schedules</a></li>
                        </ul>
                    </li> *@

                  @*   <li class="has-dropdown">
                        <a href="#results">Results</a>
                        <ul class="dropdown">
                            <li><a asp-area="" asp-controller="Admin" asp-action="ViewResults">View Results</a></li>
                            <li><a asp-area="" asp-controller="Admin" asp-action="UploadResults">Upload Results</a></li>
                            <li><a asp-area="" asp-controller="Admin" asp-action="GenerateReports">Generate Reports</a></li>
                        </ul>
                    </li> *@

                    @* <li class="has-dropdown">
                        <a href="#finance">Finance</a>
                        <ul class="dropdown">
                            <li><a asp-area="" asp-controller="Admin" asp-action="Payments">Payments</a></li>
                            <li><a asp-area="" asp-controller="Admin" asp-action="Invoices">Invoices</a></li>
                            <li><a asp-area="" asp-controller="Admin" asp-action="FinancialReports">Financial Reports</a></li>
                        </ul>
                    </li> *@

                    @* <li class="has-dropdown">
                        <a href="#reports">Department</a>
                        <ul class="dropdown">
                            <li><a asp-area="" asp-controller="Department" asp-action="CreateDepartment">Department</a></li>
                             <li><a asp-area="" asp-controller="Department" asp-action="AttendanceReports">Attendance Reports</a></li>
                            <li><a asp-area="" asp-controller="Department" asp-action="EnrollmentReports">Enrollment Reports</a></li> 
                        </ul>
                    </li> *@

                  @*   <li class="has-dropdown">
                        <a href="#settings">Settings</a>
                        <ul class="dropdown">
                            <li><a asp-area="" asp-controller="Admin" asp-action="SystemSettings">System Settings</a></li>
                            <li><a asp-area="" asp-controller="Admin" asp-action="UserManagement">User Management</a></li>
                            <li><a asp-area="" asp-controller="Admin" asp-action="RolesPermissions">Roles & Permissions</a></li>
                            <li><a asp-area="" asp-controller="Admin" asp-action="BackupRestore">Backup & Restore</a></li>
                        </ul>
                    </li> *@

                    @* <li><a asp-area="" asp-controller="Admin" asp-action="Notifications">Notifications</a></li> *@

                    <li>
                        <form method="post" asp-area="" asp-controller="User" asp-action="Logout" style="margin: 0;">
                            <button type="submit" class="btn-logout" style="cursor: pointer; border: none;">Logout</button>
                        </form>
                    </li>
                </ul>
                <div class="mobile-toggle" id="mobileToggle">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer>
        <div class="container">
            <div class="footer-content">
                <div class="footer-section">
                    <h3>MITC Admin Portal</h3>
                    <p>Comprehensive management system for all administrative tasks and student records.</p>
                </div>
                <div class="footer-section">
                    <h3>Quick Access</h3>
                    <p>
                        Dashboard | Students | Courses<br>
                        Reports | Settings | Support
                    </p>
                </div>
                <div class="footer-section">
                    <h3>Support</h3>
                    <p>
                        For technical support contact IT Department<br>
                        Email: admin@mitc.iaaae.org
                    </p>
                </div>
            </div>
            <div class="copyright">
                <p>&copy; @DateTime.Now.Year Masroor International Technical College. Admin Portal - All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        const mobileToggle = document.getElementById('mobileToggle');
        const navMenu = document.getElementById('navMenu');

        mobileToggle.addEventListener('click', () => {
            navMenu.classList.toggle('active');
        });

        // Handle dropdown clicks on mobile
        document.querySelectorAll('.has-dropdown > a').forEach(item => {
            item.addEventListener('click', (e) => {
                if (window.innerWidth <= 1024) {
                    e.preventDefault();
                    const parent = item.parentElement;
                    parent.classList.toggle('active');
                }
            });
        });

        // Close mobile menu when clicking outside
        document.addEventListener('click', (e) => {
            if (!e.target.closest('nav') && navMenu.classList.contains('active')) {
                navMenu.classList.remove('active');
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
