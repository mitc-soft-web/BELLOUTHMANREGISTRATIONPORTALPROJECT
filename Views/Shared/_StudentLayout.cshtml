<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MITC Student Portal</title>
    <link rel="icon" type="image/png" href="~/favicon.png" asp-append-version="true" />
    <link rel="shortcut icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/favicon.png" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            line-height: 1.6;
            color: #333;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            background: #f5f5f5;
        }

        main {
            flex: 1;
            padding: 30px 20px;
        }

        .top-bar {
            background: #0066cc;
            color: #fff;
            padding: 10px 0;
            font-size: 14px;
        }

            .top-bar .container {
                max-width: 1400px;
                margin: 0 auto;
                padding: 0 20px;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

        .user-info {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .user-avatar {
            width: 35px;
            height: 35px;
            border-radius: 50%;
            background: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #0066cc;
            font-weight: bold;
        }

        nav {
            background: #fff;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
            position: sticky;
            top: 0;
            z-index: 1000;
        }

            nav .container {
                max-width: 1400px;
                margin: 0 auto;
                padding: 0 20px;
                display: flex;
                justify-content: space-between;
                align-items: center;
                height: 80px;
            }

        .logo img {
            height: 60px;
            padding: 10px 0;
        }

        .nav-menu {
            display: flex;
            list-style: none;
            align-items: center;
            gap: 5px;
        }

            .nav-menu > li {
                position: relative;
            }

                .nav-menu > li > a {
                    text-decoration: none;
                    color: #333;
                    font-weight: 500;
                    padding: 10px 16px;
                    display: block;
                    transition: all 0.3s;
                    font-size: 15px;
                    border-radius: 5px;
                }

                    .nav-menu > li > a:hover {
                        color: #0066cc;
                        background: #f5f8ff;
                    }

        .dropdown {
            position: absolute;
            top: 100%;
            left: 0;
            background: #fff;
            min-width: 220px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.12);
            opacity: 0;
            visibility: hidden;
            transform: translateY(10px);
            transition: all 0.3s;
            z-index: 1001;
            border-radius: 8px;
            overflow: hidden;
            margin-top: 5px;
        }

        .nav-menu > li:hover .dropdown {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        .dropdown li {
            list-style: none;
        }

            .dropdown li a {
                display: block;
                padding: 12px 20px;
                color: #555;
                text-decoration: none;
                transition: all 0.3s;
                font-size: 14px;
            }

                .dropdown li a:hover {
                    background: #f5f8ff;
                    color: #0066cc;
                    padding-left: 25px;
                }

        .btn-logout {
            padding: 10px 24px;
            background: #dc3545;
            color: #fff;
            border-radius: 6px;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s;
            border: 2px solid #dc3545;
            font-size: 14px;
        }

            .btn-logout:hover {
                background: #c82333;
                border-color: #c82333;
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba(220, 53, 69, 0.3);
            }

        .mobile-toggle {
            display: none;
            flex-direction: column;
            cursor: pointer;
        }

            .mobile-toggle span {
                width: 25px;
                height: 2px;
                background: #333;
                margin: 3px 0;
                transition: 0.3s;
            }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 20px;
        }

        footer {
            background: #1a1a1a;
            color: #fff;
            padding: 40px 20px 20px;
            margin-top: auto;
        }

        .footer-content {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 40px;
            margin-bottom: 20px;
        }

        .footer-section h3 {
            margin-bottom: 15px;
            color: #0066cc;
            font-size: 1.1em;
        }

        .footer-section p {
            color: #ccc;
            font-size: 0.9em;
        }

        .copyright {
            text-align: center;
            padding-top: 20px;
            border-top: 1px solid #333;
            color: #888;
            font-size: 0.9em;
        }

        @@media (max-width: 992px) {
            .mobile-toggle

        {
            display: flex;
        }

        nav .container {
            height: 70px;
        }

        .logo img {
            height: 45px;
        }

        .nav-menu {
            position: absolute;
            top: 70px;
            left: 0;
            width: 100%;
            background: #fff;
            flex-direction: column;
            display: none;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        }

            .nav-menu.active {
                display: flex;
            }

            .nav-menu > li {
                width: 100%;
                text-align: center;
            }

        .dropdown {
            position: static;
            opacity: 1;
            visibility: visible;
            transform: none;
            box-shadow: none;
            display: none;
            background: #f8f8f8;
        }

        .nav-menu > li.active .dropdown {
            display: block;
        }

        .footer-content {
            grid-template-columns: 1fr;
        }

        .user-info {
            font-size: 12px;
        }

        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <div class="top-bar">
            <div class="container">
                <div>Welcome to Student Portal</div>
                <div class="user-info">
                    <div class="user-avatar">@(string.IsNullOrWhiteSpace(User.Identity?.Name) ? "S" : User.Identity.Name.Substring(0, 1).ToUpper())</div>
                    <span>@(string.IsNullOrWhiteSpace(User.Identity?.Name) ? "Student" : User.Identity.Name)</span>
                </div>
            </div>
        </div>

        <nav>
            <div class="container">
                <div class="logo">
                    <a asp-area="" asp-controller="Student" asp-action="Index">
                        <img src="~/assets/mitc_logo.png" onerror="this.onerror=null;this.src='https://mitc.iaaae.org/wp-content/uploads/2024/12/logo3.jpg';" asp-append-version="true" alt="MITC Logo">
                    </a>
                </div>
                <ul class="nav-menu" id="navMenu">
                    <li><a asp-area="" asp-controller="Student" asp-action="Index">Dashboard</a></li>
                    @* <li class="has-dropdown">
                        <a href="#profile">Profile</a>
                        <ul class="dropdown">
                            <li><a asp-area="" asp-controller="Student" asp-action="ViewProfile">View Profile</a></li>
                            <li><a asp-area="" asp-controller="Student" asp-action="EditProfile">Edit Profile</a></li>
                            <li><a asp-area="" asp-controller="Student" asp-action="ChangePassword">Change Password</a></li>
                        </ul>
                    </li> *@
                    <li>
                        <form method="post" asp-area="" asp-controller="User" asp-action="Logout" style="margin: 0;">
                            <button type="submit" class="btn-logout" style="cursor: pointer; border: none;">Logout</button>
                        </form>
                    </li>
                </ul>
                <div class="mobile-toggle" id="mobileToggle">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer>
        <div class="container">
            <div class="footer-content">
                <div class="footer-section">
                    <h3>MITC Student Portal</h3>
                    <p>Access your courses, assignments, and track your academic progress all in one place.</p>
                </div>
                <div class="footer-section">
                    <h3>Support Hours</h3>
                    <p>
                        Mon – Thurs: 8 AM – 5 PM<br>
                        Fri: 8 AM – 2:30 PM
                    </p>
                </div>
                <div class="footer-section">
                    <h3>Contact Support</h3>
                    <p>
                        Phone: 08160167443, 09070682495<br>
                        Email: support@mitc.iaaae.org
                    </p>
                </div>
            </div>
            <div class="copyright">
                <p>&copy; @DateTime.Now.Year Masroor International Technical College. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        const mobileToggle = document.getElementById('mobileToggle');
        const navMenu = document.getElementById('navMenu');

        mobileToggle.addEventListener('click', () => {
            navMenu.classList.toggle('active');
        });

        // Handle dropdown clicks on mobile
        document.querySelectorAll('.has-dropdown > a').forEach(item => {
            item.addEventListener('click', (e) => {
                if (window.innerWidth <= 992) {
                    e.preventDefault();
                    const parent = item.parentElement;
                    parent.classList.toggle('active');
                }
            });
        });

        // Close mobile menu when clicking outside
        document.addEventListener('click', (e) => {
            if (!e.target.closest('nav') && navMenu.classList.contains('active')) {
                navMenu.classList.remove('active');
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>