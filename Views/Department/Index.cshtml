@using Mitc_Registration_Portal.Models.DTOs
@model BaseResponse<IEnumerable<Mitc_Registration_Portal.Models.DTOs.Departments.DepartmentDtos>>
@{
    ViewData["Title"] = "All Departments";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    /* --- Professional Theme Styles --- */
    :root {
        --primary-gradient: linear-gradient(135deg, #0066cc 0%, #0066cc 100%);
        --card-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
        --hover-shadow: 0 8px 25px rgba(40, 167, 69, 0.15);
        --text-dark: #333;
        --text-muted: #666;
        --border-radius: 12px;
    }

    /* Page Header */
    .page-header {
        background: var(--primary-gradient);
        color: #fff;
        padding: 30px;
        border-radius: var(--border-radius);
        margin-bottom: 30px;
        box-shadow: 0 4px 15px rgba(40, 167, 69, 0.2);
    }

        .page-header h1 {
            margin: 0 0 10px 0;
            font-size: 1.8rem;
            display: flex;
            align-items: center;
            gap: 15px;
        }

    .breadcrumb {
        background: transparent;
        padding: 0;
        margin: 0;
        display: flex;
        gap: 10px;
        font-size: 0.9rem;
        opacity: 0.9;
    }

        .breadcrumb a {
            color: #fff;
            text-decoration: none;
        }

        .breadcrumb span {
            opacity: 0.7;
        }

    /* Stats Grid */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: #fff;
        padding: 20px;
        border-radius: var(--border-radius);
        box-shadow: var(--card-shadow);
        display: flex;
        align-items: center;
        gap: 20px;
        transition: transform 0.2s;
    }

        .stat-card:hover {
            transform: translateY(-5px);
        }

    .stat-icon {
        width: 60px;
        height: 60px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        color: white;
    }

        .stat-icon.green {
            background: var(--primary-gradient);
        }

        .stat-icon.blue {
            background: linear-gradient(135deg, #007bff 0%, #0056b3 100%);
        }

    .stat-content h3 {
        margin: 0;
        font-size: 1.8rem;
        color: var(--text-dark);
    }

    .stat-content p {
        margin: 0;
        color: var(--text-muted);
        font-size: 0.9rem;
    }

    /* Main Layout Grid */
    .content-layout {
        display: grid;
        grid-template-columns: 1fr 350px;
        gap: 25px;
    }

    /* Table/Card Section */
    .main-card {
        background: #fff;
        border-radius: var(--border-radius);
        box-shadow: var(--card-shadow);
        overflow: hidden;
    }

    .card-header-bar {
        padding: 20px 25px;
        background: #f8f9fa;
        border-bottom: 1px solid #eee;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
    }

    .search-wrapper {
        position: relative;
        width: 300px;
    }

    .search-input {
        width: 100%;
        padding: 10px 15px 10px 40px;
        border: 1px solid #ddd;
        border-radius: 8px;
        outline: none;
        transition: all 0.3s;
    }

        .search-input:focus {
            border-color: #0066cc;
            box-shadow: 0 0 0 3px rgba(40,167,69,0.1);
        }

    .search-icon {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: #999;
    }

    .btn-add {
        background: #0066cc;
        color: white;
        padding: 10px 20px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 500;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: 0.3s;
    }

        .btn-add:hover {
            background: #0066cc;
            box-shadow: 0 4px 12px rgba(40,167,69,0.3);
            color: white;
            transform: translateY(-1px);
        }

    /* Departments Grid inside Main Card */
    .dept-grid-container {
        padding: 25px;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 20px;
    }

    .dept-card {
        background: #fff;
        border: 1px solid #eee;
        border-radius: 10px;
        padding: 20px;
        position: relative;
        overflow: hidden;
        transition: all 0.3s ease;
    }

        .dept-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 4px;
            height: 100%;
            background: #ddd;
            transition: 0.3s;
        }

        .dept-card:hover {
            border-color: #0066cc;
            transform: translateY(-3px);
            box-shadow: var(--hover-shadow);
        }

            .dept-card:hover::before {
                background: #0066cc;
            }

    .dept-title {
        font-size: 1.1rem;
        font-weight: 700;
        color: #333;
        margin-bottom: 5px;
        display: flex;
        justify-content: space-between;
        align-items: start;
    }

    .badge-code {
        background: #e8f5e9;
        color: #0066cc;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.5px;
    }

    .dept-meta {
        margin-top: 15px;
        font-size: 0.85rem;
        color: #777;
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .meta-row {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .card-actions {
        margin-top: 20px;
        padding-top: 15px;
        border-top: 1px dashed #eee;
        display: flex;
        gap: 10px;
        justify-content: flex-end;
    }

    .action-btn {
        width: 32px;
        height: 32px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: none;
        cursor: pointer;
        transition: 0.2s;
    }

    .btn-edit {
        background: #fff3e0;
        color: #f57c00;
    }

        .btn-edit:hover {
            background: #f57c00;
            color: white;
        }

    .btn-delete {
        background: #ffebee;
        color: #c62828;
    }

        .btn-delete:hover {
            background: #c62828;
            color: white;
        }

    /* Sidebar */
    .sidebar {
        background: #fff;
        border-radius: var(--border-radius);
        box-shadow: var(--card-shadow);
        padding: 25px;
        height: fit-content;
    }

        .sidebar h3 {
            font-size: 1.1rem;
            border-bottom: 2px solid #f0f0f0;
            padding-bottom: 10px;
            margin-bottom: 20px;
        }

    .quick-link {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 12px;
        border-radius: 8px;
        background: #f8f9fa;
        margin-bottom: 10px;
        text-decoration: none;
        color: #333;
        transition: 0.2s;
    }

        .quick-link:hover {
            background: #e9ecef;
            transform: translateX(5px);
        }

    .icon-box {
        width: 35px;
        height: 35px;
        background: #e8f5e9;
        color: #0066cc;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* Empty State */
    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: #999;
    }

        .empty-state svg {
            opacity: 0.3;
            margin-bottom: 20px;
        }

    @@media (max-width: 992px) {
        .content-layout {
            grid-template-columns: 1fr;
        }

        .card-header-bar {
            flex-direction: column;
            align-items: stretch;
        }

        .search-wrapper {
            width: 100%;
        }
    }
</style>

<div class="page-header">
    <div class="breadcrumb">
        <a asp-controller="Student" asp-action="GetAllStudent">Dashboard</a>
        <span>/</span>
        <span>Departments</span>
    </div>
    <h1>
        <svg width="28" height="28" fill="currentColor" viewBox="0 0 16 16">
            <path d="M1 2.5A1.5 1.5 0 0 1 2.5 1h3A1.5 1.5 0 0 1 7 2.5v3A1.5 1.5 0 0 1 5.5 7h-3A1.5 1.5 0 0 1 1 5.5v-3zM2.5 2a.5.5 0 0 0-.5.5v3a.5.5 0 0 0 .5.5h3a.5.5 0 0 0 .5-.5v-3a.5.5 0 0 0-.5-.5h-3zm6.5.5A1.5 1.5 0 0 1 10.5 1h3A1.5 1.5 0 0 1 15 2.5v3A1.5 1.5 0 0 1 13.5 7h-3A1.5 1.5 0 0 1 9 5.5v-3zm1.5-.5a.5.5 0 0 0-.5.5v3a.5.5 0 0 0 .5.5h3a.5.5 0 0 0 .5-.5v-3a.5.5 0 0 0-.5-.5h-3zM1 10.5A1.5 1.5 0 0 1 2.5 9h3A1.5 1.5 0 0 1 7 10.5v3A1.5 1.5 0 0 1 5.5 15h-3A1.5 1.5 0 0 1 1 13.5v-3zm1.5-.5a.5.5 0 0 0-.5.5v3a.5.5 0 0 0 .5.5h3a.5.5 0 0 0 .5-.5v-3a.5.5 0 0 0-.5-.5h-3zm6.5.5A1.5 1.5 0 0 1 10.5 9h3a1.5 1.5 0 0 1 1.5 1.5v3a1.5 1.5 0 0 1-1.5 1.5h-3A1.5 1.5 0 0 1 9 13.5v-3zm1.5-.5a.5.5 0 0 0-.5.5v3a.5.5 0 0 0 .5.5h3a.5.5 0 0 0 .5-.5v-3a.5.5 0 0 0-.5-.5h-3z" />
        </svg>
        All Departments
    </h1>
    <p style="margin:0; opacity: 0.9;">Manage your academic departments and codes</p>
</div>

<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-icon green">
            <svg width="24" height="24" fill="currentColor" viewBox="0 0 16 16"><path d="M4 11a1 1 0 1 1 2 0v1a1 1 0 1 1-2 0v-1zm6-4a1 1 0 1 1 2 0v5a1 1 0 1 1-2 0V7zM7 9a1 1 0 0 1 2 0v3a1 1 0 1 1-2 0V9z" /></svg>
        </div>
        <div class="stat-content">
            <h3>@(Model?.Data.Count() ?? 0)</h3>
            <p>Total Departments</p>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon blue">
            <svg width="24" height="24" fill="currentColor" viewBox="0 0 16 16"><path d="M8 3.5a.5.5 0 0 0-1 0V9a.5.5 0 0 0 .252.434l3.5 2a.5.5 0 0 0 .496-.868L8 8.71V3.5z" /></svg>
        </div>
        <div class="stat-content">
            <h3>@(Model?.Data.Count(x => x.DateCreated >= DateTime.Now.AddDays(-7)) ?? 0)</h3>
            <p>Added This Week</p>
        </div>
    </div>
</div>

<div class="content-layout">
    <div class="main-card">
        <div class="card-header-bar">
            <div class="search-wrapper">
                <svg class="search-icon" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" />
                </svg>
                <input type="text" id="deptSearch" class="search-input" placeholder="Search by name or code..." onkeyup="filterDepartments()">
            </div>
            <a asp-action="CreateDepartment" class="btn-add">
                <svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16"><path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z" /></svg>
                New Department
            </a>
        </div>

        <div class="dept-grid-container" id="deptGrid">
            @if (Model != null && Model.Data.Any())
            {
                foreach (var item in Model.Data)
                {
                    <div class="dept-card">
                        <div class="dept-title">
                            @item.DepartmentName
                            <span class="badge-code">@item.DepartmentalCode</span>
                        </div>

                        <div class="dept-meta">
                            <div class="meta-row">
                                <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5zM1 4v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4H1z" /></svg>
                                <span>Created: @item.DateCreated.ToString("MMM dd, yyyy")</span>
                            </div>
                            <div class="meta-row">
                                <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M3.5 11.5a3.5 3.5 0 1 1 3.163-5H14L15.5 8 14 9.5l-1-1.5a3.5 3.5 0 1 1-6 3.5zM12 6.5a.5.5 0 0 1 .5.5v3a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5v-3a.5.5 0 0 1 .5-.5h1z" /></svg>
                                <span>ID: #@item.Id.ToString().Substring(0, Math.Min(item.Id.ToString().Length, 8))</span>
                            </div>
                        </div>

                        <div class="card-actions">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="action-btn btn-edit" title="Edit">
                                <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0l1.293 1.293zm-1.75 2.456-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12l6.813-6.814z" /><path fill-rule="evenodd" d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5 1.5 0 0 0 1 2.5v11z" /></svg>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="action-btn btn-delete" title="Delete" onclick="return confirm('Are you sure you want to delete this department?');">
                                <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z" /><path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3V2h11v1h-11z" /></svg>
                            </a>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="empty-state" style="grid-column: 1 / -1;">
                    <svg width="64" height="64" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M14 1a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1h-2.5a2 2 0 0 0-1.6.8L8 14.333 6.1 11.8a2 2 0 0 0-1.6-.8H2a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h12z" />
                    </svg>
                    <h4>No Departments Found</h4>
                    <p>Get started by creating your first department.</p>
                </div>
            }
        </div>
    </div>

    <div class="sidebar">
        <h3>Quick Actions</h3>

        <a asp-controller="Department" asp-action="GetAllDepartmentAndStudent" class="quick-link">
            <div class="icon-box">
                <svg width="20" height="20" fill="currentColor" viewBox="0 0 16 16"><path d="M14 1a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h12zM2 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2H2z" /><path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z" /></svg>
            </div>
            <div>
                <strong>Add Course</strong>
                <div style="font-size:0.8rem; color:#666;">Assign to department</div>
            </div>
        </a>
    </div>
</div>

@section Scripts {
    <script>
        function filterDepartments() {
            var input = document.getElementById("deptSearch");
            var filter = input.value.toUpperCase();
            var grid = document.getElementById("deptGrid");
            var cards = grid.getElementsByClassName("dept-card");

            for (var i = 0; i < cards.length; i++) {
                var title = cards[i].querySelector(".dept-title");
                var txtValue = title.textContent || title.innerText;
                if (txtValue.toUpperCase().indexOf(filter) > -1) {
                    cards[i].style.display = "";
                } else {
                    cards[i].style.display = "none";
                }
            }
        }
    </script>
}